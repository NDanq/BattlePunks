  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "InstantReplay". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("Match.Goal", function(...) self:Event_Match_Goal(...) end),
            Events.On("ReplayFinished", function(...) self:Event_ReplayFinished(...) end),
        }
        Replay.RecordOnly("Transform,Render,Animation")
        Replay.StartRecording(10, 30)
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_Match_Goal = function(self, Arg1, Arg2, Arg3, Arg4)
        local Ok1
        Replay.StopRecording()
        Ok1 = Replay.Save("Saved/Replays/LastGoal.nmreplay")
        Replay.Play(true)
        Replay.SetRate(0.5)
    end,

    Event_ReplayFinished = function(self, Arg1, Arg2, Arg3, Arg4)
        Replay.Stop(true)
        Replay.SetRate(1)
        Replay.StartRecording(10, 30)
    end,
}
]]></Output>
