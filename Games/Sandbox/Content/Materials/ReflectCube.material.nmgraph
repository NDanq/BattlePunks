  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ReflectCube". Do not edit.
// Opaque, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ReflectCube.material.
UBO_BLOCK_BEGIN(2, ReflectCube_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(ReflectCube_Block)

// Textures, by material texture slot; ReflectCube.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = Material_SampleCubeStrip(Material_Texture1, Material_ReflectionVector(Inputs, Inputs.WorldNormal));
    Surface.Emissive = t0.rgb;
}
#endif
]]></Output>
