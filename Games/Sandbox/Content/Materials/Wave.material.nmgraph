  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Wave". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Wave.material.
UBO_BLOCK_BEGIN(2, Wave_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Color;
    float Param_Height;
    float Param_Roughness;
UBO_BLOCK_END(Wave_Block)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    float t0 = vec4(Inputs.WorldPosition, 1.0).x;
    float t1 = Scene_Time.x + t0;
    float t2 = sin(t1);
    float t3 = t2 * Param_Height;
    vec3 t4 = Inputs.WorldNormal * vec3(t3);
    return t4;
}
#endif

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Param_Color * Material_Tint.xyz;
    Surface.BaseColor = t0;
    Surface.Roughness = Param_Roughness;
}
#endif
]]></Output>
