  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "MipProbe". Do not edit.
// Opaque, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in MipProbe.material.
UBO_BLOCK_BEGIN(2, MipProbe_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(MipProbe_Block)

// Textures, by material texture slot; MipProbe.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(16.0);
    vec4 t1 = texture(Material_Texture1, t0);
    Surface.Emissive = t1.rgb;
}
#endif
]]></Output>
