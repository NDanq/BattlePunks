<?xml version="1.0" encoding="utf-8"?>
<UI Format="1" ReferenceSize="1920,1080" Graph="Content/UI/SaveSlotRow.ui.nmgraph">
  <Border Name="Row" Padding="16,6" Background.Tint="#FFFFFF0A">
    <HorizontalBox Name="Content" Spacing="16">
      <Text Name="Slot" Text="{Bind:Name}" FontSize="24" Color="#F5F8FCFF" Fill="1" VAlign="Center"/>
      <Text Name="Time" Text="{Bind:Time}" FontSize="20" Color="#9FB3C8FF" VAlign="Center"/>
      <Button Name="Delete" Padding="14,6" OnClick="Graph:Delete_OnClick" Normal.Tint="#5A1E1EE6" Hovered.Tint="#A33A3AF2">
        <Text Text="Delete" FontSize="20" Color="#F5F8FCFF"/>
      </Button>
    </HorizontalBox>
  </Border>
</UI>
