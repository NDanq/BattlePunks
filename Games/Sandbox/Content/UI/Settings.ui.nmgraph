  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the UI graph "Settings". Do not edit.
return {

    OnOpen = function(self)
        local t1 = Config.GetString("Profile.Name")
        UI.SetString("Profile.Name", t1)
        UI.SetCount("Saves", 6)
        for Index1 = 0, 5 do
            local t2 = ("Saves" .. "." .. math.floor(Index1) .. "." .. "Name")
            local t3 = "Slot " .. tostring(Index1)
            UI.SetString(t2, t3)
            local t4 = ("Saves" .. "." .. math.floor(Index1) .. "." .. "Time")
            local t5 = "Played " .. tostring(Index1)
            local t6 = t5 .. "h"
            UI.SetString(t4, t6)
        end
    end,

    OnClose = function(self)
        local Saved2
        local t1 = UI.GetString("Profile.Name")
        Config.SetString("Profile.Name", t1)
        Saved2 = Config.Save()
    end,
}
]]></Output>
