<?xml version="1.0" encoding="utf-8"?>
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="UIOnly" Layer="10" Script="Content/UI/MainMenu.lua">
  <Styles>
    <Style Name="MenuButton" Type="Button" Padding="32,14" Margin="0,8" Normal.Tint="#1C2430E6" Normal.OutlineColor="#FFFFFF2E" Normal.OutlineThickness="1" Hovered.Tint="#2F6FD9F2" Hovered.OutlineColor="#BFD9FFE6" Hovered.OutlineThickness="2" Pressed.Tint="#1A4A99F2"/>
    <Style Name="MenuLabel" Type="Text" FontSize="34" Color="#F5F8FCFF" HAlign="Center" VAlign="Center"/>
  </Styles>
  <Canvas Name="Root">
    <Border Name="Backdrop" Anchors="0,0,1,1" Background.Tint="#070A10D9"/>
    <VerticalBox Name="Menu" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" AutoSize="true">
      <Text Name="Title" Text="NIMBLE SANDBOX" FontSize="88" Color="#FFFFFFFF" HAlign="Center" ShadowOffset="0,4" ShadowColor="#000000B3"/>
      <Text Name="Subtitle" Text="BrickBreaker" FontSize="32" Color="#9FB3C8FF" HAlign="Center" Margin="0,0,0,48"/>
      <Button Name="Play" Class="MenuButton" InitialFocus="true" OnClick="Lua:MainMenu.Play">
        <Text Class="MenuLabel" Text="Play"/>
      </Button>
      <Button Name="Settings" Class="MenuButton" OnClick="Native:UI.Open('Content/UI/Settings.nmui')">
        <Text Class="MenuLabel" Text="Settings"/>
      </Button>
      <Button Name="Quit" Class="MenuButton" OnClick="Native:Game.Quit">
        <Text Class="MenuLabel" Text="Quit"/>
      </Button>
      <Text Name="Hint" Text="Arrows or D-pad to choose, Enter or (A) to select" FontSize="20" Color="#FFFFFF73" HAlign="Center" Margin="0,40,0,0"/>
    </VerticalBox>
  </Canvas>
  <Animations>
    <Animation Name="Intro" Duration="0.5">
      <Track Target="Menu" Property="Opacity" Easing="CubicOut">
        <Key Time="0" Value="0"/>
        <Key Time="0.5" Value="1"/>
      </Track>
    </Animation>
  </Animations>
</UI>
