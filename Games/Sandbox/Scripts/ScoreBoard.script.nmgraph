  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "ScoreBoard". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("ScoreChanged", function(...) self:Event_ScoreChanged(...) end),
            Events.On("PickupCollected", function(...) self:Event_PickupCollected(...) end),
        }
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_ScoreChanged = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = "Score " .. tostring(math.floor(Arg1 or 0))
        local t2 = t1 .. ", rank "
        local t3 = Sandbox.RankForScore(math.floor(Arg1 or 0))
        local t4 = t2 .. t3
        print(t4)
    end,

    Event_PickupCollected = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = Arg1:GetComponent("Pickup")
        local t2_Value, t2_ID = t1:GetStats()
        local t3 = Sandbox.DescribeStats(t2_Value, t2_ID)
        local t4 = "Collected " .. t3
        print(t4)
    end,
}
]]></Output>
  </gen_code>
