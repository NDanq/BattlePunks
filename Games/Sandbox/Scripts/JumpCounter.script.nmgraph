  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "JumpCounter". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    Jumps = 0,

    OnTick = function(self, dt)
        local t1 = self.Entity:GetComponent("Input")
        local t2 = t1:WasPressed("Jump")
        if t2 then
            local t3 = self.Jumps + 1
            self.Jumps = math.floor(t3)
            local t4 = "Marker jumps: " .. tostring(self.Jumps)
            print(t4)
        end
    end,
}
]]></Output>
  </gen_code>
