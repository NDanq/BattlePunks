  <Comments>
    <Comment X="-1140" Y="-60" Width="2040" Height="420" Text="A BrickBreaker brick: each hit by the ball takes one off its Brick component's Hits (set by row: more near the top); at none it scores Points for player 0 through the game framework (Game.AddScore), tells the mode (BrickBroken) and destroys its prefab instance." />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "Brick". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    Points = 10,

    OnOverlapBegin = function(self, other, mine)
        local Score1, Set2
        local t1 = self.Entity:GetComponent("Brick")
        local t2 = t1:GetHits()
        local t3 = t2 - 1
        t1:SetHits(math.floor(t3))
        local t4 = self.Entity:GetComponent("Brick")
        local t5 = t4:GetHits()
        local t6 = t5 <= 0
        if t6 then
            local t7 = Game.GetPlayer(0)
            Score1 = Game.AddScore(t7, self.Points)
            Events.Emit("BrickBroken")
            self.Instance:Destroy()
        else
            local t8 = self.Entity:GetComponent("Render")
            Set2 = t8:SetMaterialParameter(0, "Color", 1, 0, 0, 1)
        end
    end,
}
]]></Output>
  </gen_code>
