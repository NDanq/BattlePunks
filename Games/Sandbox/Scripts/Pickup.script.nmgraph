  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "Pickup". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnTick = function(self, dt)
        local Value1, Score2
        local t1 = self.Entity:GetComponent("Transform")
        local t2 = self.Entity:GetComponent("Pickup")
        local t3_X, t3_Y, t3_Z = t2:GetHome()
        local t4 = Sandbox.GetElapsed()
        local t5 = t2:GetBobHeight()
        local t6 = t3_X * 0.01
        local t7 = Sandbox.Bob(t4, t5, t6)
        local t8 = t3_Y + t7
        t1:SetPosition(t3_X, t8, t3_Z)
        local t9 = World.FindEntity("Marker")
        local t10 = t9:GetComponent("Transform")
        local t11_X, t11_Y, t11_Z = t10:GetPosition()
        local t12 = self.Entity:GetComponent("Pickup")
        local t13_X, t13_Y, t13_Z = t12:GetHome()
        local t14 = Sandbox.GetElapsed()
        local t15 = t12:GetBobHeight()
        local t16 = t13_X * 0.01
        local t17 = Sandbox.Bob(t14, t15, t16)
        local t18 = t13_Y + t17
        local t19_X, t19_Y, t19_Z = t11_X - t13_X, t11_Y - t18, t11_Z - t13_Z
        local t20 = math.sqrt(t19_X * t19_X + t19_Y * t19_Y + t19_Z * t19_Z)
        local t21 = Sandbox.GetPickupRadius()
        local t22 = t20 < t21
        if t22 then
            local t23 = self.Entity:GetComponent("Pickup")
            Value1 = t23:Collect()
            Score2 = Sandbox.AddScore(Value1)
            Events.Emit("PickupCollected", self.Entity, Value1)
            self.Entity:Destroy()
        end
    end,
}
]]></Output>
