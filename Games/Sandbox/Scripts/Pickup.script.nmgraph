  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "Pickup". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnTick = function(self, dt)
        local t1 = self.Entity:GetComponent("Transform")
        local t2 = self.Entity:GetComponent("Pickup")
        local t3_X, t3_Y, t3_Z = t2:GetHome()
        local t4 = Sandbox.GetElapsed()
        local t5 = t2:GetBobHeight()
        local t6 = t3_X * 0.01
        local t7 = Sandbox.Bob(t4, t5, t6)
        local t8 = t3_Y + t7
        t1:SetPosition(t3_X, t8, t3_Z)
    end,

    OnOverlapBegin = function(self, other)
        local Value1, Score2
        local t1 = self.Entity:GetComponent("Pickup")
        Value1 = t1:Collect()
        Score2 = Sandbox.AddScore(Value1)
        Events.Emit("PickupCollected", self.Entity, Value1)
        self.Entity:Destroy()
    end,
}
]]></Output>
