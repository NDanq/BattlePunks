    <Comment X="-920" Y="-40" Width="1500" Height="340" Text="Every tick: move to where BobPosition puts the Pickup's Home" />
    <Comment X="-680" Y="480" Width="1260" Height="340" Text="Function BobPosition(Home, Height) -> Position: Home, raised by Sandbox.Bob over Sandbox.Elapsed (phase from X)" />
