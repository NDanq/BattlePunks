  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "Pickup". Do not edit.
local Fn_BobPosition
Fn_BobPosition = function(self, In_Home_X, In_Home_Y, In_Home_Z, In_Height)
    local t1 = Sandbox.GetElapsed()
    local t2 = In_Home_X * 0.01
    local t3 = Sandbox.Bob(t1, In_Height, t2)
    local t4 = In_Home_Y + t3
    do return In_Home_X, t4, In_Home_Z end
    return 0, 0, 0
end

return {
    TickPhase = TickPhase.PrePhysics,

    OnTick = function(self, dt)
        local Position1_X, Position1_Y, Position1_Z
        local t1 = self.Entity:GetComponent("Pickup")
        local t2_X, t2_Y, t2_Z = t1:GetHome()
        local t3 = t1:GetBobHeight()
        Position1_X, Position1_Y, Position1_Z = Fn_BobPosition(self, t2_X, t2_Y, t2_Z, t3)
        local t4 = self.Entity:GetComponent("Transform")
        t4:SetPosition(Position1_X, Position1_Y, Position1_Z)
    end,

    OnOverlapBegin = function(self, other)
        local Value2, Score3
        local t1 = self.Entity:GetComponent("Pickup")
        Value2 = t1:Collect()
        Score3 = Sandbox.AddScore(Value2)
        Events.Emit("PickupCollected", self.Entity, Value2)
        self.Entity:Destroy()
    end,
}
]]></Output>
