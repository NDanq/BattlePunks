  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Textured". Do not edit.
// Opaque, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-31 are the engine's; the parameters' offsets are in Textured.material.
UBO_BLOCK_BEGIN(2, Textured_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
UBO_BLOCK_END(Textured_Block)

// Textures, by material texture slot; Textured.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    Surface.Emissive = t0.rgb;
}
#endif
]]></Output>
