  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Ripples". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-31 are the engine's; the parameters' offsets are in Ripples.material.
UBO_BLOCK_BEGIN(2, Ripples_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec3  Param_Color;
UBO_BLOCK_END(Ripples_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = 0.0;
    HINT_UNROLL for(int i0 = 0; i0 < 5; ++i0)
    {
        float t1 = float(i0) * 1.2566371;
        float t2 = cos(t1);
        float t3 = sin(t1);
        vec2 t4 = vec2(t2, t3);
        vec2 t5 = t4 * vec2(0.3);
        vec2 t6 = t5 + vec2(0.5);
        float t7 = distance(Inputs.TexCoord, t6);
        float t8 = t7 * 60.0;
        float t9 = sin(t8);
        float t10 = t0 + t9;
        t0 = t10;
    }
    float t11 = t0 * 0.1;
    float t12 = t11 + 0.5;
    vec3 t13 = Param_Color * vec3(t12);
    vec4 t14 = vec4(t13, 1.0) * Material_Tint;
    Surface.BaseColor = t14.xyz;
}
#endif
]]></Output>
