  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Glow". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-31 are the engine's; the parameters' offsets are in Glow.material.
UBO_BLOCK_BEGIN(2, Glow_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec3  Param_Color;
UBO_BLOCK_END(Glow_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = distance(Inputs.TexCoord, vec2(0.5));
    float t1 = t0 * 2.0;
    float t2 = 1.0 - t1;
    float t3 = clamp(t2, 0.0, 1.0);
    vec3 t4 = Param_Color * vec3(t3);
    vec4 t5 = vec4(t4, 1.0) * Material_Tint;
    Surface.Emissive = t5.rgb;
    Surface.Opacity = t5.a;
}
#endif
]]></Output>
