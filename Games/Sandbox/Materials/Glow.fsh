#version 440 core
// Generated by NimbleEditor from the material graph "Glow". Do not edit.

#include <Common.glsl>

OUTPUT(0, vec4, Output)

// Columns 0-2: parameters (see Glow.material); column 3: the primitive's tint.
UBO_BEGIN(2, Glow_Block)
    SHADER_UNIFORM(mat4, MaterialParams)
UBO_END(Glow_Block)

void main(void)
{
    float t0 = distance(Interpolants.TexCoord, vec2(0.5));
    float t1 = t0 * 2.0;
    float t2 = 1.0 - t1;
    float t3 = clamp(t2, 0.0, 1.0);
    vec3 t4 = MaterialParams[0].xyz * vec3(t3);
    vec4 t5 = vec4(t4, 1.0) * MaterialParams[3];
    Output = t5;
}
