  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "ValveControl". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("Lab.Signal", function(...) self:Event_Lab_Signal(...) end),
        }
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_Lab_Signal = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = Arg1 == "L2.Valve1"
        if t1 then
            Lab.ShowBanner("Valve 1 of 3 open. Pressure rising.", 2.5)
        end
        local t2 = Arg1 == "L2.Valve2"
        if t2 then
            Lab.ShowBanner("Valve 2 of 3 open.", 2.5)
        end
        local t3 = Arg1 == "L2.Valve3"
        if t3 then
            Lab.Emit("L2.ValvesDone", true)
            Lab.ShowBanner("Pressure up: the elevator has power.", 3)
        end
    end,
}
]]></Output>
