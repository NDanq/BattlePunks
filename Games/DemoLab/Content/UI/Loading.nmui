<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo Lab's loading card: the engine's level transition opens it between
  levels ([LevelTransition] Document in Config/DefaultGame.ini), over its
  black (layer 900). LabTravel::Travel gives the title and a tip; the session
  binds Transition.Title, Transition.Tip and Transition.Level.
-->
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="GameOnly" Layer="960">
  <Canvas Name="Root">
    <Border Name="Back" Anchors="0,0,1,1" Background.Tint="#0A0704FF"/>
    <Border Name="Band" Anchors="0,0.62,1,0.80" Background.Tint="#1A120AFF" Background.OutlineColor="#C9822E66"
            Background.OutlineThickness="1"/>
    <Border Name="Rule" Anchors="0.06,0.645,0.06,0.645" Size="120,4" Background.Tint="#E8A33AFF"/>
    <Text Name="Level" Anchors="0.06,0.66,0.94,0.69" Text="DEMO LAB" FontSize="22" Color="#C9BBA0FF"/>
    <Text Name="Title" Anchors="0.06,0.69,0.94,0.75" Text="{Bind:Transition.Title}" FontSize="56" Color="#F4EBDDFF"
          ShadowOffset="0,3" ShadowColor="#000000C0"/>
    <Text Name="Tip" Anchors="0.06,0.75,0.94,0.79" Text="{Bind:Transition.Tip}" FontSize="24" Wrap="true" Color="#C9BBA0FF"/>
    <Text Name="Gear" Anchors="0.94,0.92,0.94,0.92" Pivot="1,1" AutoSize="true" Text="Loading" FontSize="22" Color="#E8A33AB0"/>
  </Canvas>
</UI>
