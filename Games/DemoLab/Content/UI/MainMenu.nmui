<?xml version="1.0" encoding="utf-8"?>
<!--
  Demo Lab's main menu, over the MainMenu world's facade at dusk (LabMenu,
  Source/GameModes/LabMenuMode.cpp). Buttons run the native actions in
  Source/UI/LabUI.cpp; Continue shows only when there is a checkpoint.
-->
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="UIOnly" Layer="10">
  <Styles>
    <Style Name="MenuButton" Type="Button" Padding="32,14" Margin="0,7" Size="560,0"
           Normal.Tint="#1A120AE0" Normal.OutlineColor="#C9822E50" Normal.OutlineThickness="1"
           Hovered.Tint="#C9822EF2" Hovered.OutlineColor="#FFE2A8E6" Hovered.OutlineThickness="2"
           Pressed.Tint="#8A561CF2" Disabled.Tint="#1A120A80"/>
    <Style Name="MenuLabel" Type="Text" FontSize="30" Color="#F4EBDDFF" HAlign="Center" VAlign="Center"/>
    <Style Name="TabButton" Type="Button" Padding="20,10" Margin="0,0,10,0"
           Normal.Tint="#1A120AE0" Normal.OutlineColor="#C9822E50" Normal.OutlineThickness="1"
           Hovered.Tint="#C9822EF2" Pressed.Tint="#8A561CF2"/>
    <Style Name="TabLabel" Type="Text" FontSize="24" Color="#F4EBDDFF" HAlign="Center" VAlign="Center"/>
    <Style Name="Heading" Type="Text" FontSize="64" Color="#F4EBDDFF" HAlign="Center" Margin="0,0,0,20"
           ShadowOffset="0,3" ShadowColor="#000000A0"/>
    <Style Name="Sub" Type="Text" FontSize="24" Color="#C9BBA0FF" HAlign="Center" Margin="0,0,0,24"/>
    <Style Name="Setting" Type="CheckBox" Margin="0,8" BoxSize="30" Spacing="16"
           Box.Tint="#0A0806E6" Box.OutlineColor="#FFFFFF4D" Box.OutlineThickness="2"
           BoxHovered.Tint="#1A120AF2" BoxHovered.OutlineColor="#C9822EFF" BoxHovered.OutlineThickness="2"
           Check.Tint="#E8A33AFF"/>
    <Style Name="SettingLabel" Type="Text" FontSize="26" Color="#F4EBDDFF" VAlign="Center"/>
    <Style Name="SliderLabel" Type="Text" FontSize="26" Color="#F4EBDDFF" Margin="0,12,0,4"/>
    <Style Name="SliderValue" Type="Text" FontSize="24" Color="#FFFFFFB3" VAlign="Center" Margin="20,0,0,0"/>
    <Style Name="SettingSlider" Type="Slider" Size="440,36" ThumbSize="20,36" TrackHeight="8"
           Track.Tint="#0A0806E6" Track.OutlineColor="#FFFFFF33" Track.OutlineThickness="1"
           FillBrush.Tint="#E8A33AF2" Thumb.Tint="#F4EBDDFF"
           ThumbHovered.Tint="#FFD66AFF" ThumbHovered.OutlineColor="#FFFFFFFF" ThumbHovered.OutlineThickness="2"/>
  </Styles>
  <Canvas Name="Root">
    <Border Name="Shade" Anchors="0,0,0.42,1" Background.Tint="#0A070490"/>
    <VerticalBox Name="Content" Anchors="0,0.5,0,0.5" Pivot="0,0.5" Position="120,0" AutoSize="true">
      <Text Name="Title" Text="DEMO LAB" FontSize="96" Color="#E8A33AFF" ShadowOffset="0,4" ShadowColor="#000000C0"/>
      <Text Name="Subtitle" Text="a NimbleEngine showcase" FontSize="28" Color="#C9BBA0FF" Margin="4,0,0,40"/>
        <Button Name="Continue" Class="MenuButton" OnClick="Native:Lab.Continue" Visibility="{Bind:Menu.ContinueVis}">
          <Text Class="MenuLabel" Text="Continue"/>
        </Button>
        <Button Name="NewGame" Class="MenuButton" OnClick="Native:Lab.NewGame" InitialFocus="true">
          <Text Class="MenuLabel" Text="New Game"/>
        </Button>
        <Button Name="ChapterSelect" Class="MenuButton" OnClick="Native:UI.Open('Content/UI/ChapterSelect.nmui')">
          <Text Class="MenuLabel" Text="Chapter Select"/>
        </Button>
        <Button Name="SettingsButton" Class="MenuButton" OnClick="Native:UI.Open('Content/UI/Settings.nmui')">
          <Text Class="MenuLabel" Text="Settings"/>
        </Button>
        <Button Name="CreditsButton" Class="MenuButton" OnClick="Native:UI.Open('Content/UI/Credits.nmui')">
          <Text Class="MenuLabel" Text="Credits"/>
        </Button>
        <Button Name="Quit" Class="MenuButton" OnClick="Native:Game.Quit">
          <Text Class="MenuLabel" Text="Quit"/>
        </Button>
    </VerticalBox>
    <Text Name="Hint" Anchors="0,1,0,1" Pivot="0,1" Position="120,-40" AutoSize="true" FontSize="20" Color="#FFFFFF80"
          Text="F1 in game: the engine features on screen"/>
  </Canvas>
</UI>
