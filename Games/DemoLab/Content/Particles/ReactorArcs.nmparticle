NimbleParticleSystem 1

Emitter Arc0
    Enabled true
    Type Beam
    Modules
    Mesh Engine/Content/Meshes/SpriteOctagon.nmmesh
    Material Content/Materials/Particles/P_Arc.material.nmgraph
    Offset 0,0,0
    Billboard FaceCamera
    VelocityStretch 0
    MeshOrientation RandomSpin
    RandomRotation true
    RotationRate 0.3
    SpawnMode Continuous
    MaxParticles 256
    Shape Sphere
    ShapeSurface false
    BoxSize 100,100,100
    ConeAngle 25
    RingWidth 0
    ShapeSpeed 0
    SpawnRate 20
    BurstCount 16
    BurstInterval 0
    BurstCycles 1
    Lifetime 0.4
    LifetimeVariance 0.3
    EmitterRadius 10
    Seed 1
    CullDistance 12000
    PauseOffscreen true
    Velocity 0,0,0
    VelocitySpread 0
    Acceleration 0,0,0
    Drag 0
    Turbulence 0
    CollisionResponse None
    CollisionHeight -100000
    Bounce 0.3
    Friction 0.2
    FlipbookColumns 1
    FlipbookRows 1
    FlipbookFrames 0
    FlipbookRate 0
    FlipbookCycles 1
    FlipbookRandomStart false
    BeamEnd 135,-45,0
    BeamSegments 20
    BeamNoise 22
    BeamNoiseSpeed 14
    SizeMode StartEnd
    StartSize 5
    EndSize 3
    SizeKeys
    ColorMode StartEnd
    StartColor 170,215,255,255
    EndColor 120,180,255,200
    ColorCurve 0.6
    FadeIn 0
    FadeOut 0
    ColorKeys

