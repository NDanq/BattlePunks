    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "BrassAged". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in BrassAged.material.
UBO_BLOCK_BEGIN(2, BrassAged_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(BrassAged_Block)

// Textures, by material texture slot; BrassAged.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(2.0);
    vec4 t1 = texture(Material_Texture2, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    float t3 = vec4(Inputs.Color.rgb, 1.0).x;
    float t4 = mix(0.6, 1.0, t3);
    vec3 t5 = vec3(t4, t4, t4);
    vec3 t6 = t2 * t5;
    Surface.BaseColor = t6;
    vec4 t7 = texture(Material_Texture3, t0);
    Surface.Metallic = t7.b;
    float t8 = t7.g * 1.1;
    Surface.Roughness = t8;
    vec4 t9 = texture(Material_Texture1, t0);
    vec3 t10 = Material_NormalMap(Inputs, t9.rgb, 1.0, t0, -1.0);
    Surface.Normal = t10;
    float t11 = t7.r * t3;
    Surface.AmbientOcclusion = t11;
}
#endif
]]></Output>
