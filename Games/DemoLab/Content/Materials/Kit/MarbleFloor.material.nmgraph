    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "MarbleFloor". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in MarbleFloor.material.
UBO_BLOCK_BEGIN(2, MarbleFloor_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(MarbleFloor_Block)

// Textures, by material texture slot; MarbleFloor.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.5);
    vec4 t1 = texture(Material_Texture1, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec3 t3 = t2 * vec3(0.52, 0.47, 0.42);
    vec2 t4 = Inputs.TexCoord * vec2(0.33333334);
    vec4 t5 = texture(Material_Texture4, t4);
    float t6 = t5.r * 0.8;
    float t7 = vec4(Inputs.Color.rgb, 1.0).x;
    float t8 = 1.0 - t7;
    float t9 = t8 * 1.5;
    float t10 = t6 + t9;
    float t11 = t10 * 0.25;
    float t12 = clamp(t11, 0.0, 1.0);
    vec3 t13 = vec3(t12, t12, t12);
    vec3 t14 = mix(t2, t3, t13);
    float t15 = mix(0.6, 1.0, t7);
    vec3 t16 = vec3(t15, t15, t15);
    vec3 t17 = t14 * t16;
    Surface.BaseColor = t17;
    vec4 t18 = texture(Material_Texture3, t0);
    Surface.Metallic = t18.b;
    float t19 = t12 * 0.18;
    float t20 = t18.g + t19;
    float t21 = t5.a * 0.12;
    float t22 = t21 + -0.06;
    float t23 = t20 + t22;
    float t24 = clamp(t23, 0.0, 1.0);
    Surface.Roughness = t24;
    vec4 t25 = texture(Material_Texture2, t0);
    vec3 t26 = Material_NormalMap(Inputs, t25.rgb, 1.0, t0, -1.0);
    Surface.Normal = t26;
    float t27 = t18.r * t7;
    Surface.AmbientOcclusion = t27;
}
#endif
]]></Output>
