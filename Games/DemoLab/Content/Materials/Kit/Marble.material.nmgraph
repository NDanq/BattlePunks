  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Marble". Do not edit.
// Opaque, Lit, Subsurface. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Marble.material.
UBO_BLOCK_BEGIN(2, Marble_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Marble_Block)

// Textures, by material texture slot; Marble.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Param_Tint;
    float t2 = vec4(Inputs.Color.rgb, 1.0).x;
    float t3 = mix(0.6, 1.0, t2);
    vec3 t4 = vec3(t3, t3, t3);
    vec3 t5 = t1 * t4;
    Surface.BaseColor = t5;
    vec4 t6 = texture(Material_Texture2, Inputs.TexCoord);
    Surface.Metallic = t6.b;
    Surface.Roughness = t6.g;
    vec4 t7 = texture(Material_Texture3, Inputs.TexCoord);
    vec3 t8 = Material_NormalMap(Inputs, t7.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t8;
    float t9 = t6.r * t2;
    Surface.AmbientOcclusion = t9;
    vec3 t10 = t5 * vec3(0.95, 0.88, 0.78);
    Surface.SubsurfaceColor = t10;
    Surface.Thickness = 0.6;
}
#endif
]]></Output>
