  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "SeaFoam". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Translucency Lighting Surface: specular over the opacity, premultiplied (MaterialTemplate_PS.glsl).
#define MATERIAL_TRANSLUCENCY_SURFACE 1

// Bytes 0-159 are the engine's; the parameters' offsets are in SeaFoam.material.
UBO_BLOCK_BEGIN(2, SeaFoam_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(SeaFoam_Block)

// Textures, by material texture slot; SeaFoam.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(1.5);
    vec2 t1 = vec2(Scene_Time.x, Scene_Time.x);
    vec2 t2 = t1 * vec2(0.004, 0.035);
    vec2 t3 = t0 + t2;
    vec4 t4 = texture(Material_Texture1, t3);
    Surface.BaseColor = t4.rgb;
    Surface.Metallic = 0.0;
    Surface.Roughness = 0.65;
    float t5 = t4.a * 1.6;
    float t6 = t5 + -0.25;
    float t7 = clamp(t6, 0.0, 1.0);
    float t8 = vec4(Inputs.TexCoord, 0.0, 1.0).y;
    float t9 = smoothstep(0.0, 0.35, t8);
    float t10 = smoothstep(1.0, 0.9, t8);
    float t11 = t9 * t10;
    float t12 = t7 * t11;
    float t13 = t8 * 18.0;
    float t14 = Scene_Time.x * -1.4;
    float t15 = t13 + t14;
    float t16 = sin(t15);
    float t17 = t16 * 0.35;
    float t18 = t17 + 0.65;
    float t19 = t18 * t8;
    float t20 = t19 * 0.6;
    float t21 = t20 + 0.25;
    float t22 = t12 * t21;
    float t23 = clamp(t22, 0.0, 1.0);
    Surface.Opacity = t23;
}
#endif
]]></Output>
