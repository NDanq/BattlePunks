    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "PanelRed". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in PanelRed.material.
UBO_BLOCK_BEGIN(2, PanelRed_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(PanelRed_Block)

// Textures, by material texture slot; PanelRed.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.5);
    vec4 t1 = texture(Material_Texture3, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec4 t3 = texture(Material_Texture2, t0);
    float t4 = Inputs.Color.a * t3.r;
    float t5 = smoothstep(0.45, 0.8, t4);
    float t6 = 1.0 - t5;
    float t7 = t1.a * t6;
    vec3 t8 = mix(vec3(0.4, 0.39, 0.37), t2, vec3(t7));
    float t9 = vec4(Inputs.Color.rgb, 1.0).x;
    float t10 = mix(0.6, 1.0, t9);
    vec3 t11 = vec3(t10, t10, t10);
    vec3 t12 = t8 * t11;
    Surface.BaseColor = t12;
    float t13 = 1.0 - t7;
    Surface.Metallic = t13;
    Surface.Roughness = t3.g;
    vec4 t14 = texture(Material_Texture1, t0);
    vec3 t15 = Material_NormalMap(Inputs, t14.rgb, 1.0, t0, -1.0);
    Surface.Normal = t15;
    float t16 = t3.r * t9;
    Surface.AmbientOcclusion = t16;
}
#endif
]]></Output>
