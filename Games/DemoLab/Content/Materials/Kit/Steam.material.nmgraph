  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Steam". Do not edit.
// Translucent, Lit, Volume. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Translucency Lighting Surface: specular over the opacity, premultiplied (MaterialTemplate_PS.glsl).
#define MATERIAL_TRANSLUCENCY_SURFACE 1

// Bytes 0-159 are the engine's; the parameters' offsets are in Steam.material.
UBO_BLOCK_BEGIN(2, Steam_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_BaseColor;
    float Param_Roughness;
UBO_BLOCK_END(Steam_Block)

// Textures, by material texture slot; Steam.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = Param_BaseColor;
    Surface.Roughness = Param_Roughness;
    vec3 t0 = Scene_CameraPosition.xyz - Inputs.WorldPosition;
    vec3 t1 = normalize(t0);
    float t2 = dot(t1, Inputs.WorldNormal);
    float t3 = abs(t2);
    float t4 = clamp(t3, 0.0, 1.0);
    float t5 = t4 * t4;
    float t6 = t5 * 0.7;
    float t7 = vec4(Inputs.WorldPosition, 1.0).x;
    float t8 = t7 * 0.028571429;
    float t9 = vec4(Inputs.WorldPosition, 1.0).z;
    float t10 = t9 * 0.02;
    float t11 = t8 + t10;
    float t12 = vec4(Inputs.WorldPosition, 1.0).y;
    float t13 = t12 * 0.028571429;
    float t14 = Scene_Time.x * -0.09;
    float t15 = t13 + t14;
    vec2 t16 = vec2(t11, t15);
    vec2 t17 = vec2(Scene_Time.x, Scene_Time.x);
    vec2 t18 = t17 * vec2(0.013, 0.0);
    vec2 t19 = t16 + t18;
    vec4 t20 = texture(Material_Texture1, t19);
    float t21 = t7 * 0.077220075;
    float t22 = t9 * 0.054054055;
    float t23 = t21 + t22;
    float t24 = t12 * 0.077220075;
    float t25 = Scene_Time.x * -0.171;
    float t26 = t24 + t25;
    vec2 t27 = vec2(t23, t26);
    vec2 t28 = vec2(Scene_Time.x, Scene_Time.x);
    vec2 t29 = t28 * vec2(-0.031, 0.0);
    vec2 t30 = t27 + t29;
    vec4 t31 = texture(Material_Texture1, t30);
    float t32 = t31.r * 1.2;
    float t33 = t32 + 0.2;
    float t34 = t20.r * t33;
    float t35 = smoothstep(0.06, 0.5, t34);
    float t36 = t6 * t35;
    Surface.Opacity = t36;
    Surface.PhaseAnisotropy = 0.45;
    Surface.NormalInfluence = 0.3;
}
#endif
]]></Output>
