    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Walnut". Do not edit.
// Opaque, Lit, ClearCoat. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Walnut.material.
UBO_BLOCK_BEGIN(2, Walnut_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Walnut_Block)

// Textures, by material texture slot; Walnut.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture2, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Param_Tint;
    vec3 t2 = t1 * vec3(0.52, 0.47, 0.42);
    vec2 t3 = Inputs.TexCoord * vec2(0.33333334);
    vec4 t4 = texture(Material_Texture4, t3);
    float t5 = t4.r * 0.8;
    float t6 = vec4(Inputs.Color.rgb, 1.0).x;
    float t7 = 1.0 - t6;
    float t8 = t7 * 1.5;
    float t9 = t5 + t8;
    float t10 = t9 * 0.15;
    float t11 = clamp(t10, 0.0, 1.0);
    vec3 t12 = vec3(t11, t11, t11);
    vec3 t13 = mix(t1, t2, t12);
    vec3 t14 = t13 * vec3(1.25);
    float t15 = t4.b * 0.9;
    float t16 = t15 + 0.5;
    float t17 = Inputs.Color.a * t16;
    float t18 = smoothstep(0.3, 0.65, t17);
    float t19 = t18 * 0.7;
    vec3 t20 = vec3(t19, t19, t19);
    vec3 t21 = mix(t13, t14, t20);
    float t22 = mix(0.6, 1.0, t6);
    vec3 t23 = vec3(t22, t22, t22);
    vec3 t24 = t21 * t23;
    Surface.BaseColor = t24;
    vec4 t25 = texture(Material_Texture1, Inputs.TexCoord);
    Surface.Metallic = t25.b;
    float t26 = t11 * 0.18;
    float t27 = t25.g + t26;
    float t28 = t18 * 0.08;
    float t29 = t27 + t28;
    float t30 = t4.a * 0.12;
    float t31 = t30 + -0.06;
    float t32 = t29 + t31;
    float t33 = clamp(t32, 0.0, 1.0);
    Surface.Roughness = t33;
    vec4 t34 = texture(Material_Texture3, Inputs.TexCoord);
    vec3 t35 = Material_NormalMap(Inputs, t34.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t35;
    float t36 = t25.r * t6;
    Surface.AmbientOcclusion = t36;
    Surface.ClearCoatRoughness = 0.06;
}
#endif
]]></Output>
