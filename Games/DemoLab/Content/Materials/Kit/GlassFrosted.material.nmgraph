  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "GlassFrosted". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Translucency Lighting Surface: specular over the opacity, premultiplied (MaterialTemplate_PS.glsl).
#define MATERIAL_TRANSLUCENCY_SURFACE 1

// Refraction: what is seen through it bent, read from this frame's opaque copy (Refraction.glsl).
#define MATERIAL_REFRACTION 1

// Bytes 0-159 are the engine's; the parameters' offsets are in GlassFrosted.material.
UBO_BLOCK_BEGIN(2, GlassFrosted_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(GlassFrosted_Block)

// Textures, by material texture slot; GlassFrosted.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture3, Inputs.TexCoord);
    vec3 t1 = Param_Tint * t0.rgb;
    float t2 = vec4(Inputs.Color.rgb, 1.0).x;
    float t3 = mix(0.6, 1.0, t2);
    vec3 t4 = vec3(t3, t3, t3);
    vec3 t5 = t1 * t4;
    Surface.BaseColor = t5;
    vec4 t6 = texture(Material_Texture1, Inputs.TexCoord);
    Surface.Metallic = t6.b;
    float t7 = t6.g + 0.35;
    Surface.Roughness = t7;
    float t8 = t0.a * 0.3;
    float t9 = t8 + 0.6;
    Surface.Opacity = t9;
    vec4 t10 = texture(Material_Texture2, Inputs.TexCoord);
    vec3 t11 = Material_NormalMap(Inputs, t10.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t11;
    float t12 = t6.r * t2;
    Surface.AmbientOcclusion = t12;
    Surface.Refraction = 1.04;
}
#endif
]]></Output>
