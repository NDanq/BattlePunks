  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ObjectiveHighlight". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ObjectiveHighlight.material.
UBO_BLOCK_BEGIN(2, ObjectiveHighlight_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Color;
    float Param_Glow;
    float Param_Intensity;
    float Param_PulseSpeed;
    float Param_Push;
UBO_BLOCK_END(ObjectiveHighlight_Block)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    vec3 t0 = vec3(Param_Push, Param_Push, Param_Push);
    vec3 t1 = Inputs.WorldNormal * t0;
    return t1;
}
#endif

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Scene_CameraPosition.xyz - Inputs.WorldPosition;
    vec3 t1 = normalize(t0);
    vec3 t2 = normalize(Inputs.WorldNormal);
    float t3 = dot(t1, t2);
    float t4 = abs(t3);
    float t5 = 1.0 - t4;
    float t6 = clamp(t5, 0.0, 1.0);
    float t7 = pow(t6, 2.5);
    float t8 = t7 + 0.12;
    float t9 = Scene_Time.x * Param_PulseSpeed;
    float t10 = sin(t9);
    float t11 = t10 * 0.3;
    float t12 = t11 + 0.7;
    float t13 = t12 * Param_Glow;
    float t14 = t8 * t13;
    vec3 t15 = vec3(t14, t14, t14);
    vec3 t16 = Param_Color * t15;
    vec3 t17 = vec3(Param_Intensity, Param_Intensity, Param_Intensity);
    vec3 t18 = t16 * t17;
    Surface.Emissive = t18;
    float t19 = t14 * 0.8;
    float t20 = clamp(t19, 0.0, 1.0);
    Surface.Opacity = t20;
}
#endif
]]></Output>
