    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "PlateSteel". Do not edit.
// Opaque, Lit, Anisotropic. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in PlateSteel.material.
UBO_BLOCK_BEGIN(2, PlateSteel_Block)
