MATERIAL_SAMPLER2D(9, Material_Texture5)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(2.0);
    vec4 t1 = texture(Material_Texture4, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec3 t3 = t2 * vec3(0.52, 0.47, 0.42);
    vec4 t4 = texture(Material_Texture3, Inputs.TexCoord);
    float t5 = t4.r * 0.8;
    float t6 = vec4(Inputs.Color.rgb, 1.0).x;
    float t7 = 1.0 - t6;
    float t8 = t7 * 1.5;
    float t9 = t5 + t8;
    float t10 = t9 * 0.5;
    float t11 = clamp(t10, 0.0, 1.0);
    vec3 t12 = vec3(t11, t11, t11);
    vec3 t13 = mix(t2, t3, t12);
    float t14 = t4.g * 0.7;
    float t15 = clamp(t14, 0.0, 1.0);
    float t16 = t15 * 0.85;
    vec3 t17 = vec3(t16, t16, t16);
    vec3 t18 = mix(t13, vec3(0.36, 0.17, 0.07), t17);
    vec3 t19 = t18 * vec3(1.35);
    float t20 = t4.b * 0.9;
    float t21 = t20 + 0.5;
    float t22 = Inputs.Color.a * t21;
    float t23 = smoothstep(0.3, 0.65, t22);
    vec3 t24 = vec3(t23, t23, t23);
    vec3 t25 = mix(t18, t19, t24);
    float t26 = mix(0.6, 1.0, t6);
    vec3 t27 = vec3(t26, t26, t26);
    vec3 t28 = t25 * t27;
    Surface.BaseColor = t28;
    vec4 t29 = texture(Material_Texture2, t0);
    float t30 = 1.0 - t15;
    float t31 = t29.b * t30;
    Surface.Metallic = t31;
    float t32 = t29.g * 0.9;
    float t33 = t11 * 0.18;
    float t34 = t32 + t33;
    float t35 = t15 * 0.3;
    float t36 = t34 + t35;
    float t37 = t36 * 0.55;
    float t38 = mix(t36, t37, t23);
    float t39 = t4.a * 0.12;
    float t40 = t39 + -0.06;
    float t41 = t38 + t40;
    float t42 = clamp(t41, 0.0, 1.0);
    Surface.Roughness = t42;
    vec4 t43 = texture(Material_Texture5, t0);
    vec2 t44 = Inputs.TexCoord * vec2(2.0);
    vec4 t45 = texture(Material_Texture1, t44);
    vec3 t46 = t45.rgb * vec3(0.6, 0.6, 0.0);
    vec3 t47 = t46 + vec3(-0.3, -0.3, 0.0);
    vec3 t48 = t43.rgb + t47;
    vec3 t49 = Material_NormalMap(Inputs, t48, 1.0, t0, -1.0);
    Surface.Normal = t49;
    float t50 = t29.r * t6;
    Surface.AmbientOcclusion = t50;
    Surface.Anisotropy = 0.7;
}
