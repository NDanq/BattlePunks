    vec4 t3 = texture(Material_Texture5, t0);
    float t4 = Inputs.Color.a * t3.r;
    vec2 t5 = Inputs.TexCoord * vec2(0.33333334);
    vec4 t6 = texture(Material_Texture2, t5);
    float t7 = t6.b * 1.2;
    float t8 = t7 + 0.3;
    float t9 = t4 * t8;
    float t10 = smoothstep(0.45, 0.8, t9);
    float t11 = 1.0 - t10;
    float t12 = t1.a * t11;
    vec3 t13 = mix(vec3(0.4, 0.39, 0.37), t2, vec3(t12));
    vec3 t14 = t13 * vec3(0.52, 0.47, 0.42);
    float t15 = t6.r * 0.8;
    float t16 = vec4(Inputs.Color.rgb, 1.0).x;
    float t17 = 1.0 - t16;
    float t18 = t17 * 1.5;
    float t19 = t15 + t18;
    float t20 = t19 * 0.55;
    float t21 = clamp(t20, 0.0, 1.0);
    vec3 t22 = vec3(t21, t21, t21);
    vec3 t23 = mix(t13, t14, t22);
    float t24 = t6.g * 0.55;
    float t25 = clamp(t24, 0.0, 1.0);
    float t26 = t25 * 0.85;
    vec3 t27 = vec3(t26, t26, t26);
    vec3 t28 = mix(t23, vec3(0.38, 0.18, 0.07), t27);
    float t29 = mix(0.6, 1.0, t16);
    vec3 t30 = vec3(t29, t29, t29);
    vec3 t31 = t28 * t30;
    Surface.BaseColor = t31;
    float t32 = 1.0 - t12;
    float t33 = 1.0 - t25;
    float t34 = t32 * t33;
    Surface.Metallic = t34;
    float t35 = t21 * 0.18;
    float t36 = t3.g + t35;
    float t37 = t25 * 0.3;
    float t38 = t36 + t37;
    float t39 = t6.a * 0.12;
    float t40 = t39 + -0.06;
    float t41 = t38 + t40;
    float t42 = clamp(t41, 0.0, 1.0);
    Surface.Roughness = t42;
    vec4 t43 = texture(Material_Texture4, t0);
