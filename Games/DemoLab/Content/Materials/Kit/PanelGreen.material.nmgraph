    vec4 t45 = texture(Material_Texture1, t44);
    vec3 t46 = t45.rgb * vec3(0.4, 0.4, 0.0);
    vec3 t47 = t46 + vec3(-0.2, -0.2, 0.0);
    vec3 t48 = t43.rgb + t47;
    vec3 t49 = Material_NormalMap(Inputs, t48, 1.0, t0, -1.0);
    Surface.Normal = t49;
    float t50 = t3.r * t16;
    Surface.AmbientOcclusion = t50;
