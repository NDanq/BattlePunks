    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ReactorGlow". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ReactorGlow.material.
UBO_BLOCK_BEGIN(2, ReactorGlow_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_BaseColor;
    vec3  Param_EmissiveColor;
    float Param_EmissiveIntensity;
    float Param_PulseSpeed;
    float Param_Roughness;
UBO_BLOCK_END(ReactorGlow_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = vec4(Inputs.Color.rgb, 1.0).x;
    float t1 = mix(0.6, 1.0, t0);
    vec3 t2 = vec3(t1, t1, t1);
    vec3 t3 = Param_BaseColor * t2;
    Surface.BaseColor = t3;
    Surface.Metallic = 0.0;
    Surface.Roughness = Param_Roughness;
    vec3 t4 = vec3(Param_EmissiveIntensity, Param_EmissiveIntensity, Param_EmissiveIntensity);
    vec3 t5 = Param_EmissiveColor * t4;
    float t6 = Scene_Time.x * Param_PulseSpeed;
    float t7 = t6 * 6.2831855;
    float t8 = sin(t7);
    float t9 = t8 * 0.25;
    float t10 = t9 + 0.75;
    vec3 t11 = vec3(t10, t10, t10);
    vec3 t12 = t5 * t11;
    Surface.Emissive = t12;
    Surface.AmbientOcclusion = t0;
}
#endif
]]></Output>
