  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "LeafPanel". Do not edit.
// Opaque, Lit, Subsurface. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in LeafPanel.material.
UBO_BLOCK_BEGIN(2, LeafPanel_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(LeafPanel_Block)

// Textures, by material texture slot; LeafPanel.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    float t1 = vec4(Inputs.Color.rgb, 1.0).x;
    float t2 = mix(0.6, 1.0, t1);
    vec3 t3 = vec3(t2, t2, t2);
    vec3 t4 = t0.rgb * t3;
    Surface.BaseColor = t4;
    Surface.Metallic = 0.0;
    Surface.Roughness = 0.55;
    Surface.AmbientOcclusion = t1;
    vec3 t5 = t4 * vec3(1.4, 1.5, 0.9);
    Surface.SubsurfaceColor = t5;
    Surface.Thickness = 0.12;
}
#endif
]]></Output>
