    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Canvas". Do not edit.
// Opaque, Lit, Cloth. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Canvas.material.
UBO_BLOCK_BEGIN(2, Canvas_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Canvas_Block)

// Textures, by material texture slot; Canvas.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.25);
    vec4 t1 = texture(Material_Texture4, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec3 t3 = t2 * vec3(0.52, 0.47, 0.42);
    vec2 t4 = Inputs.TexCoord * vec2(0.33333334);
    vec4 t5 = texture(Material_Texture2, t4);
    float t6 = t5.r * 0.8;
    float t7 = vec4(Inputs.Color.rgb, 1.0).x;
    float t8 = 1.0 - t7;
    float t9 = t8 * 1.5;
    float t10 = t6 + t9;
    float t11 = t10 * 0.3;
    float t12 = clamp(t11, 0.0, 1.0);
    vec3 t13 = vec3(t12, t12, t12);
    vec3 t14 = mix(t2, t3, t13);
    vec3 t15 = t14 * vec3(0.72, 0.7, 0.64);
    float t16 = t5.g * 0.6;
    float t17 = clamp(t16, 0.0, 1.0);
    vec3 t18 = vec3(t17, t17, t17);
    vec3 t19 = mix(t14, t15, t18);
    float t20 = mix(0.6, 1.0, t7);
    vec3 t21 = vec3(t20, t20, t20);
    vec3 t22 = t19 * t21;
    Surface.BaseColor = t22;
    vec4 t23 = texture(Material_Texture3, t0);
    Surface.Metallic = t23.b;
    float t24 = t12 * 0.18;
    float t25 = t23.g + t24;
    float t26 = t17 * -0.12;
    float t27 = t25 + t26;
    float t28 = t5.a * 0.12;
    float t29 = t28 + -0.06;
    float t30 = t27 + t29;
    float t31 = clamp(t30, 0.0, 1.0);
    Surface.Roughness = t31;
    vec4 t32 = texture(Material_Texture1, t0);
    vec3 t33 = Material_NormalMap(Inputs, t32.rgb, 1.0, t0, -1.0);
    Surface.Normal = t33;
    float t34 = t23.r * t7;
    Surface.AmbientOcclusion = t34;
    Surface.SheenColor = vec3(0.45, 0.43, 0.38);
    Surface.SubsurfaceColor = vec3(0.7, 0.65, 0.5);
}
#endif
]]></Output>
