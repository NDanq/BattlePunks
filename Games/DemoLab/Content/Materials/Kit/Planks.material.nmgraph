#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.5);
    vec4 t1 = texture(Material_Texture1, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec3 t3 = t2 * vec3(0.52, 0.47, 0.42);
    vec2 t4 = Inputs.TexCoord * vec2(0.33333334);
    vec4 t5 = texture(Material_Texture2, t4);
    float t6 = t5.r * 0.8;
    float t7 = vec4(Inputs.Color.rgb, 1.0).x;
    float t8 = 1.0 - t7;
    float t9 = t8 * 1.5;
    float t10 = t6 + t9;
    float t11 = t10 * 0.5;
    float t12 = clamp(t11, 0.0, 1.0);
    vec3 t13 = vec3(t12, t12, t12);
    vec3 t14 = mix(t2, t3, t13);
    vec3 t15 = t14 * vec3(0.62, 0.64, 0.52);
    float t16 = t5.g * 0.8;
    float t17 = clamp(t16, 0.0, 1.0);
    vec3 t18 = vec3(t17, t17, t17);
    vec3 t19 = mix(t14, t15, t18);
    vec3 t20 = t19 * vec3(1.25);
    float t21 = t5.b * 0.9;
    float t22 = t21 + 0.5;
    float t23 = Inputs.Color.a * t22;
    float t24 = smoothstep(0.3, 0.65, t23);
    float t25 = t24 * 0.7;
    vec3 t26 = vec3(t25, t25, t25);
    vec3 t27 = mix(t19, t20, t26);
    float t28 = mix(0.6, 1.0, t7);
    vec3 t29 = vec3(t28, t28, t28);
    vec3 t30 = t27 * t29;
    Surface.BaseColor = t30;
    vec4 t31 = texture(Material_Texture4, t0);
    Surface.Metallic = t31.b;
    float t32 = t12 * 0.18;
    float t33 = t31.g + t32;
    float t34 = t17 * -0.12;
    float t35 = t33 + t34;
    float t36 = t24 * 0.08;
    float t37 = t35 + t36;
    float t38 = t5.a * 0.12;
    float t39 = t38 + -0.06;
    float t40 = t37 + t39;
    float t41 = clamp(t40, 0.0, 1.0);
    Surface.Roughness = t41;
    vec4 t42 = texture(Material_Texture5, t0);
