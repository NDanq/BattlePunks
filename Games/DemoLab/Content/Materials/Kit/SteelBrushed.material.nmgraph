  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "SteelBrushed". Do not edit.
// Opaque, Lit, Anisotropic. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in SteelBrushed.material.
UBO_BLOCK_BEGIN(2, SteelBrushed_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(SteelBrushed_Block)

// Textures, by material texture slot; SteelBrushed.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Param_Tint;
    float t2 = vec4(Inputs.Color.rgb, 1.0).x;
    float t3 = mix(0.6, 1.0, t2);
    vec3 t4 = vec3(t3, t3, t3);
    vec3 t5 = t1 * t4;
    Surface.BaseColor = t5;
    vec4 t6 = texture(Material_Texture2, Inputs.TexCoord);
    Surface.Metallic = t6.b;
    float t7 = t6.g * 0.8;
    Surface.Roughness = t7;
    vec4 t8 = texture(Material_Texture3, Inputs.TexCoord);
    vec3 t9 = Material_NormalMap(Inputs, t8.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t9;
    float t10 = t6.r * t2;
    Surface.AmbientOcclusion = t10;
    Surface.Anisotropy = 0.8;
}
#endif
]]></Output>
