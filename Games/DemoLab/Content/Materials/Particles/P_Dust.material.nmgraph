  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "P_Dust". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in P_Dust.material.
UBO_BLOCK_BEGIN(2, P_Dust_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(P_Dust_Block)

// Textures, by material texture slot; P_Dust.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = Inputs.Color.rgb * t0.rgb;
    Surface.BaseColor = t1;
    Surface.Roughness = 0.8;
    float t2 = distance(Inputs.TexCoord, vec2(0.5));
    float t3 = t2 * 2.0;
    float t4 = 1.0 - t3;
    float t5 = clamp(t4, 0.0, 1.0);
    float t6 = distance(Inputs.TexCoord, vec2(0.5));
    float t7 = t6 * 2.0;
    float t8 = 1.0 - t7;
    float t9 = clamp(t8, 0.0, 1.0);
    float t10 = t5 * t9;
    float t11 = t10 * Inputs.Color.a;
    Surface.Opacity = t11;
}
#endif
]]></Output>
