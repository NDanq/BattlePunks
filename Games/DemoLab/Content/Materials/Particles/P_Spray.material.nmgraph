  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "P_Spray". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in P_Spray.material.
UBO_BLOCK_BEGIN(2, P_Spray_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(P_Spray_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = Inputs.Color.rgb;
    Surface.Roughness = 0.08;
    float t0 = distance(Inputs.TexCoord, vec2(0.5));
    float t1 = t0 * 2.0;
    float t2 = 1.0 - t1;
    float t3 = clamp(t2, 0.0, 1.0);
    float t4 = sqrt(t3);
    float t5 = t4 * Inputs.Color.a;
    Surface.Opacity = t5;
}
#endif
]]></Output>
