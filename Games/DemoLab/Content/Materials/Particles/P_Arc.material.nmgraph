    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "P_Arc". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in P_Arc.material.
UBO_BLOCK_BEGIN(2, P_Arc_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    float Param_Intensity;
UBO_BLOCK_END(P_Arc_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = vec4(Inputs.TexCoord, 0.0, 1.0).x;
    float t1 = t0 + -0.5;
    float t2 = abs(t1);
    float t3 = t2 * 2.0;
    float t4 = 1.0 - t3;
    float t5 = clamp(t4, 0.0, 1.0);
    float t6 = pow(t5, 3.0);
    vec3 t7 = vec3(t6, t6, t6);
    vec3 t8 = mix(Inputs.Color.rgb, vec3(1.0), t7);
    float t9 = t5 * t5;
    float t10 = vec4(Inputs.TexCoord, 0.0, 1.0).y;
    float t11 = t10 * 23.0;
    float t12 = Scene_Time.x * 70.0;
    float t13 = t11 + t12;
    float t14 = sin(t13);
    float t15 = t14 * 0.35;
    float t16 = t15 + 0.65;
    float t17 = t9 * t16;
    vec3 t18 = vec3(t17, t17, t17);
    vec3 t19 = t8 * t18;
    vec3 t20 = vec3(Param_Intensity, Param_Intensity, Param_Intensity);
    vec3 t21 = t19 * t20;
    Surface.Emissive = t21;
    float t22 = t9 * Inputs.Color.a;
    Surface.Opacity = t22;
}
#endif
]]></Output>
