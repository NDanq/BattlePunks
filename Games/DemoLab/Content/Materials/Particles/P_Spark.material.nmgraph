UBO_BLOCK_END(P_Spark_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = distance(Inputs.TexCoord, vec2(0.5));
    float t1 = t0 * 2.0;
    float t2 = 1.0 - t1;
    float t3 = clamp(t2, 0.0, 1.0);
    float t4 = t3 * t3;
    vec3 t5 = vec3(t4, t4, t4);
    vec3 t6 = Inputs.Color.rgb * t5;
    vec3 t7 = vec3(Param_Intensity, Param_Intensity, Param_Intensity);
    vec3 t8 = t6 * t7;
    Surface.Emissive = t8;
    float t9 = t4 * Inputs.Color.a;
    Surface.Opacity = t9;
}
#endif
]]></Output>
