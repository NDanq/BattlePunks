    float t25 = Scene_Time.x * 7.3;
    float t26 = sin(t25);
    float t27 = t24 * t26;
    float t28 = t27 * 0.12;
    float t29 = t28 + 0.92;
    float t30 = t22 * t29;
    float t31 = distance(Inputs.TexCoord, vec2(0.5));
    float t32 = smoothstep(0.25, 0.5, t31);
    float t33 = t32 * 0.65;
    float t34 = 1.0 - t33;
    float t35 = t30 * t34;
    float t36 = smoothstep(0.05, 0.11, t31);
    float t37 = mix(0.45, 1.0, t36);
    float t38 = t35 * t37;
    float t39 = t6 - 0.5;
    float t40 = abs(t39);
    float t41 = Scene_Time.x + Param_BlinkOffset;
    float t42 = mod(t41, Param_BlinkInterval);
    float t43 = t42 / Param_BlinkDuration;
    float t44 = t43 * 2.0;
    float t45 = t44 - 1.0;
    float t46 = abs(t45);
    float t47 = 1.0 - t46;
    float t48 = clamp(t47, 0.0, 1.0);
    float t49 = 1.0 - t48;
    float t50 = t49 * 0.5;
    float t51 = step(t40, t50);
    float t52 = t38 * t51;
    float t53 = smoothstep(0.0, 0.06, t40);
    float t54 = 1.0 - t53;
    float t55 = t54 * t48;
    float t56 = t55 * 2.5;
    float t57 = t52 + t56;
    float t58 = 1.0 - Inputs.Color.a;
