    float t1 = 1.0 - Inputs.Color.a;
    vec3 t2 = mix(t0.rgb, vec3(0.015, 0.015, 0.018), vec3(t1));
    Surface.BaseColor = t2;
    vec4 t3 = texture(Material_Texture3, Inputs.TexCoord);
    float t4 = mix(t3.b, 0.0, t1);
    Surface.Metallic = t4;
    float t5 = mix(t3.g, 0.05, t1);
    Surface.Roughness = t5;
    float t6 = vec4(Inputs.TexCoord, 0.0, 1.0).y;
    float t7 = t6 * Param_ScanlineCount;
    float t8 = Scene_Time.x * Param_ScanlineSpeed;
    float t9 = t7 + t8;
    float t10 = t9 * 6.2831855;
    float t11 = sin(t10);
    float t12 = t11 * 0.5;
    float t13 = t12 + 0.5;
    float t14 = smoothstep(0.15, 0.85, t13);
    float t15 = mix(0.3, 1.0, t14);
    float t16 = Scene_Time.x * Param_RollSpeed;
    float t17 = t6 - t16;
    float t18 = fract(t17);
    float t19 = pow(t18, 10.0);
    float t20 = t19 * 0.9;
    float t21 = t20 + 1.0;
    float t22 = t15 * t21;
    float t23 = Scene_Time.x * 61.0;
