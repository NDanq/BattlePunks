  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "L1_SpruceBark". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in L1_SpruceBark.material.
UBO_BLOCK_BEGIN(2, L1_SpruceBark_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(L1_SpruceBark_Block)

// Textures, by material texture slot; L1_SpruceBark.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    float t0 = Scene_Time.x * 0.9;
    float t1 = vec4(Inputs.WorldPosition, 1.0).x;
    float t2 = t1 * 7e-04;
    float t3 = vec4(Inputs.WorldPosition, 1.0).z;
    float t4 = t3 * 9e-04;
    float t5 = t2 + t4;
    float t6 = t0 + t5;
    float t7 = sin(t6);
    float t8 = t7 * 0.55;
    float t9 = Scene_Time.x * 2.1;
    float t10 = t5 * 1.7;
    float t11 = t9 + t10;
    float t12 = sin(t11);
    float t13 = t12 * 0.2;
    float t14 = t8 + t13;
    float t15 = t14 + 0.45;
    float t16 = t15 * Inputs.Color.a;
    float t17 = t16 * 30.0;
    float t18 = t17 * Scene_Wind.w;
    float t19 = vec4(Scene_Wind.xyz, 1.0).x;
    float t20 = t18 * t19;
    float t21 = vec4(Scene_Wind.xyz, 1.0).z;
    float t22 = t18 * t21;
    vec3 t23 = vec3(t20, 0.0, t22);
    return t23;
}
#endif

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture2, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Inputs.Color.rgb;
    Surface.BaseColor = t1;
    vec4 t2 = texture(Material_Texture3, Inputs.TexCoord);
    Surface.Roughness = t2.r;
    vec4 t3 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t4 = Material_NormalMap(Inputs, t3.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t4;
    float t5 = vec4(Inputs.Color.rgb, 1.0).x;
    float t6 = t2.g * t5;
    Surface.AmbientOcclusion = t6;
}
#endif
]]></Output>
