  <Comments>
    <Comment X="-960" Y="-80" Width="1340" Height="460" Text="On Start: the dummy stands armed (the anim state's Armed and Grounded), and remembers where it stands" />
    <Comment X="-960" Y="440" Width="1340" Height="460" Text="Ragdoll Settled (the engine's Ragdoll component, Engine/Source/RAGDOLL.md): when this dummy's body has come to rest, start the respawn clock. RangeShooter.lua's shots kill it (ActivateWithImpulse)" />
    <Comment X="-960" Y="940" Width="2120" Height="660" Text="On Tick: once RespawnSeconds have passed at rest, a fresh dummy where this one stood, and this instance goes -- with the pistol it dropped (prefab members keep their parent)" />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "RangeDummy". Do not edit.
return {
    TickPhase = TickPhase.PostPhysics,

    Rest = -1,
    RespawnSeconds = 4,
    Spawn_X = 0,
    Spawn_Y = 0,
    Spawn_Z = 0,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("RagdollSettled", function(...) self:Event_RagdollSettled(...) end),
        }
        local Set1, Set2
        local t1 = self.Root
        local t2 = t1:GetComponent("Animation")
        Set1 = t2:SetBool("Armed", true)
        local t3 = self.Root
        local t4 = t3:GetComponent("Animation")
        Set2 = t4:SetBool("Grounded", true)
        local t5 = self.Root
        local t6 = t5:GetComponent("Transform")
        local t7_X, t7_Y, t7_Z = t6:GetPosition()
        self.Spawn_X, self.Spawn_Y, self.Spawn_Z = t7_X, t7_Y, t7_Z
    end,

    OnTick = function(self, dt)
        local Root3
        local t1 = self.Rest >= 0
        if t1 then
            local t2 = self.Rest + dt
            self.Rest = t2
            local t3 = self.Rest >= self.RespawnSeconds
            if t3 then
                self.Rest = -1
                Root3 = World.SpawnPrefab("Content/Prefabs/ShootingRange/RangeDummy.nmprefab", self.Spawn_X, self.Spawn_Y, self.Spawn_Z)
                self.Instance:Destroy()
            end
        end
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_RagdollSettled = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = self.Root
        local t2 = (Arg1):GetID() == (t1):GetID()
        local t3 = self.Rest < 0
        local t4 = t2 and t3
        if t4 then
            self.Rest = 0
        end
    end,
}
]]></Output>
