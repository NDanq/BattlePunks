  <Comments>
    <Comment X="-960" Y="-80" Width="1320" Height="360" Text="On start: subtitles on, then start the level's Cinematic player (a Sequence Player placed in SteampunkStreet)" />
    <Comment X="-960" Y="340" Width="1320" Height="320" Text="Each cut: the sequence's Event track emits Flyover.Shot (Arg 1 is the shot's name)" />
    <Comment X="-960" Y="720" Width="1320" Height="320" Text="The end (or a skip): the library's Sequence Finished event, then Director.Done for gameplay to pick up" />
    <Comment X="-960" Y="1100" Width="1320" Height="220" Text="Flyover.Done is keyed fire-on-skip, so it arrives whether the cinematic played out or was skipped" />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "CinematicDirector". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("Flyover.Shot", function(...) self:Event_Flyover_Shot(...) end),
            Events.On("SequenceFinished", function(...) self:Event_SequenceFinished(...) end),
            Events.On("Flyover.Done", function(...) self:Event_Flyover_Done(...) end),
        }
        local Started1
        Sequence.SetSubtitles(true)
        local t1 = World.FindEntity("Cinematic")
        Started1 = Sequence.Start(t1)
        print("Director: rolling the flyover")
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_Flyover_Shot = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = "Director: cut to " .. Arg1
        print(t1)
    end,

    Event_SequenceFinished = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = "Director: finished " .. Arg2
        print(t1)
        Events.Emit("Director.Done")
    end,

    Event_Flyover_Done = function(self, Arg1, Arg2, Arg3, Arg4)
        print("Director: the airship is back in gameplay's hands")
    end,
}
]]></Output>
  </gen_code>
