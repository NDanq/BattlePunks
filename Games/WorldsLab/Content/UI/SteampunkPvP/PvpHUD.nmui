<?xml version="1.0" encoding="utf-8"?>
<!--
  Steampunk PvP's HUD, opened by WorldsLabPvP.cpp on every process with a player.
  The mode's TickPresentation feeds it from the local fighter's replicated fields
  and the match (UISystem::SetValue):
    Pvp.Health, HealthFill, Ammo, AmmoFill, Kills, Deaths   the local fighter
    Pvp.Time, Limit, Leader, Banner                          the match
    Pvp.Status                                               what just happened to you
    Pvp.Feed0..3                                             the kill feed, newest last
    Pvp.Score0..7                                            the scoreboard rows
  and shows Scores (Tab held, or between rounds), HitMarker and Crosshair by name.
  Nothing here takes input.
-->
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="GameOnly">
  <Styles>
    <Style Name="Label" Type="Text" FontSize="20" Color="#B8B2A6FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Value" Type="Text" FontSize="38" Color="#F2EEE4FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Feed"  Type="Text" FontSize="22" Color="#F2EEE4FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Row"   Type="Text" FontSize="26" Color="#F2EEE4FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Hair"  Type="Image" Brush.Tint="#F2EEE4E6"/>
    <Style Name="Hit"   Type="Image" Brush.Tint="#E04020FF"/>
  </Styles>
  <Canvas Name="Root">
    <!-- The match, top centre: time left, the leader, the limit. -->
    <Border Name="Match" Anchors="0.5,0,0.5,0" Pivot="0.5,0" Position="0,28" AutoSize="true" Padding="26,10"
            Visibility="HitTestInvisible" Background.Tint="#0A0A0AB0" Background.OutlineColor="#E0A82033"
            Background.OutlineThickness="1">
      <HorizontalBox Spacing="40">
        <VerticalBox>
          <Text Class="Label" Text="TIME"/>
          <Text Class="Value" Text="{Bind:Pvp.Time}"/>
        </VerticalBox>
        <VerticalBox>
          <Text Class="Label" Text="LEADER"/>
          <Text Class="Value" Text="{Bind:Pvp.Leader}"/>
        </VerticalBox>
        <VerticalBox>
          <Text Class="Label" Text="{Bind:Pvp.Limit}"/>
          <Text Class="Value" Text="{Bind:Pvp.Kills} / {Bind:Pvp.Deaths}"/>
        </VerticalBox>
      </HorizontalBox>
    </Border>

    <!-- The kill feed, top right. -->
    <VerticalBox Name="Feed" Anchors="1,0,1,0" Pivot="1,0" Position="-36,36" AutoSize="true" Spacing="4"
                 Visibility="HitTestInvisible">
      <Text Class="Feed" HAlign="Right" Text="{Bind:Pvp.Feed0}"/>
      <Text Class="Feed" HAlign="Right" Text="{Bind:Pvp.Feed1}"/>
      <Text Class="Feed" HAlign="Right" Text="{Bind:Pvp.Feed2}"/>
      <Text Class="Feed" HAlign="Right" Text="{Bind:Pvp.Feed3}"/>
    </VerticalBox>

    <!-- Health, bottom left. -->
    <Border Name="Health" Anchors="0,1,0,1" Pivot="0,1" Position="36,-36" Size="300,130" Padding="24,12"
            Visibility="HitTestInvisible" Background.Tint="#0A0A0AB0" Background.OutlineColor="#E0A82033"
            Background.OutlineThickness="1">
      <Canvas>
        <Text Class="Label" Position="0,0" AutoSize="true" Text="HEALTH"/>
        <Text Class="Value" Position="0,22" AutoSize="true" FontSize="60" Text="{Bind:Pvp.Health}"/>
        <ProgressBar Anchors="0,1,1,1" Pivot="0,1" Position="0,0" Size="0,6" Value="{Bind:Pvp.HealthFill}"
                     Background.Tint="#FFFFFF22" FillBrush.Tint="#C83A28FF"/>
      </Canvas>
    </Border>

    <!-- Ammo, bottom right. -->
    <Border Name="Ammo" Anchors="1,1,1,1" Pivot="1,1" Position="-36,-36" Size="300,130" Padding="24,12"
            Visibility="HitTestInvisible" Background.Tint="#0A0A0AB0" Background.OutlineColor="#E0A82033"
            Background.OutlineThickness="1">
      <Canvas>
        <Text Class="Label" Position="0,0" AutoSize="true" Text="9MM  P-17"/>
        <Text Class="Value" Position="0,22" AutoSize="true" FontSize="60" Text="{Bind:Pvp.Ammo}"/>
        <ProgressBar Anchors="0,1,1,1" Pivot="0,1" Position="0,0" Size="0,6" Value="{Bind:Pvp.AmmoFill}"
                     Background.Tint="#FFFFFF22" FillBrush.Tint="#E0A820FF"/>
      </Canvas>
    </Border>

    <!-- Crosshair, and the hit marker over it. -->
    <Canvas Name="Crosshair" Anchors="0.5,0.5,0.5,0.5" Size="60,60" Pivot="0.5,0.5" Visibility="HitTestInvisible">
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="0,-16" Size="2,12"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="0,16" Size="2,12"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="-16,0" Size="12,2"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="16,0" Size="12,2"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Size="3,3"/>
    </Canvas>
    <Canvas Name="HitMarker" Anchors="0.5,0.5,0.5,0.5" Size="60,60" Pivot="0.5,0.5" Visibility="Hidden">
      <Image Class="Hit" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="-11,-11" Size="10,3"/>
      <Image Class="Hit" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="11,-11" Size="10,3"/>
      <Image Class="Hit" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="-11,11" Size="10,3"/>
      <Image Class="Hit" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="11,11" Size="10,3"/>
    </Canvas>
    <Text Name="Status" Class="Label" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0" Position="0,46" AutoSize="true"
          Visibility="HitTestInvisible" FontSize="28" Color="#E0A820FF" Text="{Bind:Pvp.Status}"/>
    <Text Name="Banner" Class="Value" Anchors="0.5,0.3,0.5,0.3" Pivot="0.5,0.5" AutoSize="true"
          Visibility="HitTestInvisible" FontSize="56" Color="#E0A820FF" Text="{Bind:Pvp.Banner}"/>

    <!-- The scores: Tab, or between rounds. -->
    <Border Name="Scores" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="0,40" AutoSize="true" Padding="36,20"
            Visibility="Hidden" Background.Tint="#0A0A0AD8" Background.OutlineColor="#E0A82066"
            Background.OutlineThickness="1">
      <VerticalBox Spacing="6">
        <Text Class="Label" Text="  FIGHTER           KILLS  DEATHS"/>
        <Text Class="Row" Text="{Bind:Pvp.Score0}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score1}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score2}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score3}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score4}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score5}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score6}"/>
        <Text Class="Row" Text="{Bind:Pvp.Score7}"/>
      </VerticalBox>
    </Border>

    <Text Name="Help" Class="Label" Anchors="0.5,1,0.5,1" Pivot="0.5,1" Position="0,-30" AutoSize="true"
          Visibility="HitTestInvisible" FontSize="18" Color="#B8B2A6C0"
          Text="WASD move   SHIFT run   SPACE jump   RMB aim   LMB fire   R reload   TAB scores   ESC free mouse"/>
  </Canvas>
</UI>
