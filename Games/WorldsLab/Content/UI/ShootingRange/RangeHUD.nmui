<?xml version="1.0" encoding="utf-8"?>
<!--
  The Shooting Range's HUD, opened by Scripts/ShootingRange/RangeShooter.lua as
  its shooter starts. The script writes the Range.* strings (UI.SetString):
  Mag and Reserve the rounds, Hits / Shots / Accuracy the score, Status a
  word under the crosshair (RELOADING, EMPTY), and shows the crosshair while
  the pistol is drawn. Nothing here takes input.
-->
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="GameOnly">
  <Styles>
    <Style Name="Label" Type="Text" FontSize="20" Color="#B8B2A6FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Value" Type="Text" FontSize="38" Color="#F2EEE4FF" ShadowOffset="0,2" ShadowColor="#000000C0"/>
    <Style Name="Hair" Type="Image" Brush.Tint="#F2EEE4E6"/>
  </Styles>
  <Canvas Name="Root">
    <!-- Score, top left. -->
    <Border Name="Score" Position="36,36" AutoSize="true" Padding="22,12" Visibility="HitTestInvisible"
            Background.Tint="#0A0A0AB0" Background.OutlineColor="#E0A82033" Background.OutlineThickness="1">
      <HorizontalBox Spacing="36">
        <VerticalBox>
          <Text Class="Label" Text="HITS"/>
          <Text Name="Hits" Class="Value" Text="{Bind:Range.Hits}"/>
        </VerticalBox>
        <VerticalBox>
          <Text Class="Label" Text="SHOTS"/>
          <Text Name="Shots" Class="Value" Text="{Bind:Range.Shots}"/>
        </VerticalBox>
        <VerticalBox>
          <Text Class="Label" Text="ACCURACY"/>
          <Text Name="Accuracy" Class="Value" Text="{Bind:Range.Accuracy}"/>
        </VerticalBox>
      </HorizontalBox>
    </Border>

    <!-- Ammo, bottom right: rounds in the magazine large, the reserve beside them, a bar of what is left. -->
    <Border Name="Ammo" Anchors="1,1,1,1" Pivot="1,1" Position="-36,-36" Size="300,170" Padding="24,12"
            Visibility="HitTestInvisible" Background.Tint="#0A0A0AB0" Background.OutlineColor="#E0A82033"
            Background.OutlineThickness="1">
      <Canvas>
        <Text Class="Label" Position="0,0" AutoSize="true" Text="9MM  P-17"/>
        <HorizontalBox Position="0,22" AutoSize="true" Spacing="10">
          <Text Name="Mag" Class="Value" FontSize="72" Text="{Bind:Range.Mag}"/>
          <Text Name="Reserve" Class="Value" FontSize="34" Color="#B8B2A6FF" VAlign="Bottom" Text="/ {Bind:Range.Reserve}"/>
        </HorizontalBox>
        <ProgressBar Name="MagBar" Anchors="0,1,1,1" Pivot="0,1" Position="0,0" Size="0,6" Value="{Bind:Range.MagFill}"
                     Background.Tint="#FFFFFF22" FillBrush.Tint="#E0A820FF"/>
      </Canvas>
    </Border>

    <!-- Crosshair: four ticks and a dot, shown while drawn. -->
    <Canvas Name="Crosshair" Anchors="0.5,0.5,0.5,0.5" Size="60,60" Pivot="0.5,0.5" Visibility="Hidden">
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="0,-16" Size="2,12"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="0,16" Size="2,12"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="-16,0" Size="12,2"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Position="16,0" Size="12,2"/>
      <Image Class="Hair" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" Size="3,3"/>
    </Canvas>
    <Text Name="Status" Class="Label" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0" Position="0,46" AutoSize="true"
          Visibility="HitTestInvisible" FontSize="24" Color="#E0A820FF" Text="{Bind:Range.Status}"/>

    <!-- The controls, bottom centre. -->
    <Text Name="Help" Class="Label" Anchors="0.5,1,0.5,1" Pivot="0.5,1" Position="0,-30" AutoSize="true"
          Visibility="HitTestInvisible" FontSize="18" Color="#B8B2A6C0"
          Text="WASD move   SHIFT run   SPACE jump   H draw   RMB aim   LMB fire   R reload   ESC mouse"/>
  </Canvas>
</UI>
