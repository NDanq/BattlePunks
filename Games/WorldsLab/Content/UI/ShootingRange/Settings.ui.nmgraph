  <Comments>
    <Comment X="-920" Y="-40" Width="1760" Height="320" Text="Function Refresh: each setting's config var into the data store key its slider or check box binds to (two-way)" />
    <Comment X="-920" Y="360" Width="540" Height="180" Text="On open: show what the config vars hold now" />
    <Comment X="-920" Y="600" Width="1020" Height="820" Text="A control changed: write its config var. The HUD's hint is shown or hidden at once (another document, by its path)" />
    <Comment X="180" Y="600" Width="1800" Height="400" Text="Defaults: every setting back to the game's own value, through the same config vars, then the controls follow" />
    <Comment X="180" Y="1080" Width="540" Height="180" Text="Closed (Back, Esc, a level change, Quit): save what differs from the game's own values" />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the UI graph "Settings". Do not edit.
local Fn_Refresh
Fn_Refresh = function(self)
    local t1 = Config.GetNumber("Audio.MasterVolume")
    UI.SetNumber("RangeSettings.Master", t1)
    local t2 = Config.GetNumber("Audio.SFXVolume")
    UI.SetNumber("RangeSettings.Effects", t2)
    local t3 = Config.GetNumber("WorldsLab.RangeLookSensitivity")
    UI.SetNumber("RangeSettings.Look", t3)
    local t4 = Config.GetBool("Shadows.Enabled")
    UI.SetBool("RangeSettings.Shadows", t4)
    local t5 = Config.GetBool("WorldsLab.RangeShowHelp")
    UI.SetBool("RangeSettings.Help", t5)
end

return {

    OnOpen = function(self)
        Fn_Refresh(self)
    end,

    OnClose = function(self)
        local Saved1
        Saved1 = Config.Save()
    end,

    Master_OnChanged = function(self, Value, Sender)
        Config.SetNumber("Audio.MasterVolume", Value)
    end,

    Effects_OnChanged = function(self, Value, Sender)
        Config.SetNumber("Audio.SFXVolume", Value)
    end,

    Look_OnChanged = function(self, Value, Sender)
        Config.SetNumber("WorldsLab.RangeLookSensitivity", Value)
    end,

    Shadows_OnChanged = function(self, Value, Sender)
        Config.SetBool("Shadows.Enabled", (Value ~= 0))
    end,

    Help_OnChanged = function(self, Value, Sender)
        local Done2
        Config.SetBool("WorldsLab.RangeShowHelp", (Value ~= 0))
        Done2 = UI.SetVisible("Content/UI/ShootingRange/RangeHUD.nmui", "Help", (Value ~= 0))
    end,

    Defaults_OnClick = function(self, Value, Sender)
        local Done3
        Config.SetNumber("Audio.MasterVolume", 1)
        Config.SetNumber("Audio.SFXVolume", 1)
        Config.SetNumber("WorldsLab.RangeLookSensitivity", 1)
        Config.SetBool("Shadows.Enabled", true)
        Config.SetBool("WorldsLab.RangeShowHelp", true)
        Fn_Refresh(self)
        Done3 = UI.SetVisible("Content/UI/ShootingRange/RangeHUD.nmui", "Help", true)
    end,
}
]]></Output>
  </gen_code>
