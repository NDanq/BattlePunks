  <Comments>
    <Comment X="-700" Y="-420" Width="640" Height="90" Text="Shooting Range MuzzleFlash: a soft round flash for the pistol's and the impacts' particles; Emissive is the particle's colour x Intensity (blooms), opacity a round falloff x its alpha." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "MuzzleFlash". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in MuzzleFlash.material.
UBO_BLOCK_BEGIN(2, MuzzleFlash_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Intensity;
UBO_BLOCK_END(MuzzleFlash_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Inputs.Color.rgb * Param_Intensity;
    Surface.Emissive = t0;
    float t1 = distance(Inputs.TexCoord, vec2(0.5));
    float t2 = t1 * 2.0;
    float t3 = 1.0 - t2;
    float t4 = clamp(t3, 0.0, 1.0);
    float t5 = t4 * t4;
    float t6 = t5 * Inputs.Color.a;
    Surface.Opacity = t6;
}
#endif
]]></Output>
