  <Comments>
    <Comment X="-700" Y="-420" Width="640" Height="90" Text="Shooting Range Grating: galvanised bar grating, 0.5 m a tile; Masked on the texture's alpha so the range shows through the catwalk floor." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Grating". Do not edit.
// Masked, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Grating.material.
UBO_BLOCK_BEGIN(2, Grating_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    float Param_RoughnessScale;
    vec3  Param_Tint;
    vec2  Param_UVScale;
UBO_BLOCK_END(Grating_Block)

// Textures, by material texture slot; Grating.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * Param_UVScale;
    vec4 t1 = texture(Material_Texture2, t0);
    vec3 t2 = t1.rgb * Inputs.Color.rgb;
    vec3 t3 = t2 * Param_Tint;
    Surface.BaseColor = t3;
    vec4 t4 = texture(Material_Texture1, t0);
    Surface.Metallic = t4.b;
    float t5 = t4.g * Param_RoughnessScale;
    Surface.Roughness = t5;
    Surface.OpacityMask = t1.a;
    vec4 t6 = texture(Material_Texture3, t0);
    vec3 t7 = Material_NormalMap(Inputs, t6.rgb, 1.0, t0, -1.0);
    Surface.Normal = t7;
    Surface.AmbientOcclusion = t4.r;
}
#endif
]]></Output>
