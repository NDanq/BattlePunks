    vec4  Material_AmbientCube[6];
    float Param_Metallic;
    float Param_Roughness;
    float Param_Specular;
    vec3  Param_Tint;
UBO_BLOCK_END(DummyPaint_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Inputs.Color.rgb * Param_Tint;
    Surface.BaseColor = t0;
    Surface.Metallic = Param_Metallic;
    Surface.Roughness = Param_Roughness;
    Surface.Specular = Param_Specular;
}
#endif
]]></Output>
