  <Comments>
    <Comment X="-700" Y="-420" Width="640" Height="90" Text="Shooting Range Grit: the warehouse's grade -- desaturated a touch, cooled, contrast pulled about mid grey, a vignette, and fine film grain that changes every frame." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Grit". Do not edit.
// PostProcess, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Grit.material.
UBO_BLOCK_BEGIN(2, Grit_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec4  Param_Contrast;
    float Param_Grain;
    vec4  Param_Saturation;
    vec4  Param_Tint;
    float Param_Vignette;
UBO_BLOCK_END(Grit_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = dot(texture(Material_SceneColor, Inputs.TexCoord), vec4(0.2126, 0.7152, 0.0722, 0.0));
    vec4 t1 = vec4(1.0) * vec4(t0);
    vec4 t2 = mix(t1, texture(Material_SceneColor, Inputs.TexCoord), Param_Saturation);
    vec4 t3 = t2 * Param_Tint;
    vec4 t4 = t3 - vec4(0.18, 0.18, 0.18, 0.0);
    vec4 t5 = t4 * Param_Contrast;
    vec4 t6 = t5 + vec4(0.18, 0.18, 0.18, 0.0);
    vec4 t7 = max(t6, vec4(0.0));
    float t8 = distance(Inputs.TexCoord, vec2(0.5));
    float t9 = smoothstep(0.3, 0.85, t8);
    float t10 = t9 * Param_Vignette;
    float t11 = 1.0 - t10;
    vec4 t12 = t7 * vec4(t11);
    float t13 = Scene_Time.x * 61.7;
    vec4 t14 = Inputs.FragCoord + vec4(t13);
    float t15 = dot(t14, vec4(12.9898, 78.233, 0.0, 0.0));
    float t16 = sin(t15);
    float t17 = t16 * 43758.547;
    float t18 = fract(t17);
    float t19 = t18 - 0.5;
    float t20 = t19 * Param_Grain;
    vec4 t21 = t12 + vec4(t20);
    Surface.Emissive = t21.xyz;
}
#endif
]]></Output>
