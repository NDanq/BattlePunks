  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ToonPaint". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ToonPaint.material.
UBO_BLOCK_BEGIN(2, ToonPaint_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Glow;
    float Param_Metallic;
    float Param_Roughness;
    float Param_Specular;
    vec3  Param_Tint;
UBO_BLOCK_END(ToonPaint_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Inputs.Color.rgb * Param_Tint;
    Surface.BaseColor = t0;
    Surface.Metallic = Param_Metallic;
    Surface.Roughness = Param_Roughness;
    Surface.Specular = Param_Specular;
    vec3 t1 = t0 * Param_Glow;
    Surface.Emissive = t1;
}
#endif
]]></Output>
