  <Comments>
    <Comment X="-700" Y="-420" Width="640" Height="90" Text="Toony ToonInk: ink where the scene's depth jumps (Fwidth of its depth, relative) and where flat colours meet, the brightness banded into a few steps, a little more saturation." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ToonInk". Do not edit.
// PostProcess, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ToonInk.material.
UBO_BLOCK_BEGIN(2, ToonInk_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    float Param_BandStrength;
    float Param_Bands;
    float Param_ColourInk;
    float Param_DepthEdge0;
    float Param_DepthEdge1;
    vec4  Param_InkColor;
    float Param_InkStrength;
    vec4  Param_Saturation;
UBO_BLOCK_END(ToonInk_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = dot(Material_SceneColorAt(Inputs.TexCoord), vec4(0.2126, 0.7152, 0.0722, 0.0));
    vec4 t1 = vec4(1.0) * vec4(t0);
    float t2 = t0 * Param_Bands;
    float t3 = t2 + 0.5;
    float t4 = floor(t3);
    float t5 = t4 / Param_Bands;
    float t6 = max(t0, 0.001);
    float t7 = t5 / t6;
    float t8 = mix(1.0, t7, Param_BandStrength);
    vec4 t9 = Material_SceneColorAt(Inputs.TexCoord) * vec4(t8);
    vec4 t10 = mix(t1, t9, Param_Saturation);
    vec4 t11 = max(t10, vec4(0.0));
    float t12 = fwidth(Material_SceneDepthAt(Inputs.FragCoord.xy));
    float t13 = 1.0 - Material_SceneDepthAt(Inputs.FragCoord.xy);
    float t14 = max(t13, 1e-05);
    float t15 = t12 / t14;
    float t16 = smoothstep(Param_DepthEdge0, Param_DepthEdge1, t15);
    float t17 = fwidth(t0);
    float t18 = smoothstep(0.06, 0.16, t17);
    float t19 = t18 * Param_ColourInk;
    float t20 = max(t16, t19);
    float t21 = t20 * Param_InkStrength;
    vec4 t22 = mix(t11, Param_InkColor, vec4(t21));
    Surface.Emissive = t22.xyz;
}
#endif
]]></Output>
