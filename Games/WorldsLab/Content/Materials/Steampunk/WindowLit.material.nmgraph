  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "WindowLit". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in WindowLit.material.
UBO_BLOCK_BEGIN(2, WindowLit_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_BaseColor;
    vec3  Param_Glow;
    float Param_Roughness;
UBO_BLOCK_END(WindowLit_Block)

// Textures, by material texture slot; WindowLit.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = Param_BaseColor;
    Surface.Roughness = Param_Roughness;
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Param_Glow;
    Surface.Emissive = t1;
}
#endif
]]></Output>
