  <Comments>
    <Comment X="-700" Y="-420" Width="640" Height="90" Text="Steampunk Fabric: an airship's doped canvas envelope -- the Paint set stretched 4 m a tile, rough, faint seams; Tint colours it." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Fabric". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Fabric.material.
UBO_BLOCK_BEGIN(2, Fabric_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    float Param_RoughnessScale;
    vec3  Param_Tint;
    vec2  Param_UVScale;
UBO_BLOCK_END(Fabric_Block)

// Textures, by material texture slot; Fabric.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * Param_UVScale;
    vec4 t1 = texture(Material_Texture3, t0);
    vec3 t2 = t1.rgb * Inputs.Color.rgb;
    vec3 t3 = t2 * Param_Tint;
    Surface.BaseColor = t3;
    vec4 t4 = texture(Material_Texture1, t0);
    Surface.Metallic = t4.b;
    float t5 = t4.g * Param_RoughnessScale;
    float t6 = t5 * Inputs.Color.a;
    Surface.Roughness = t6;
    vec4 t7 = texture(Material_Texture2, t0);
    vec3 t8 = Material_NormalMap(Inputs, t7.rgb, 0.25, t0, -1.0);
    Surface.Normal = t8;
    Surface.AmbientOcclusion = t4.r;
}
#endif
]]></Output>
