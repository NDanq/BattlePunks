  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Foliage". Do not edit.
// Masked, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Foliage.material.
UBO_BLOCK_BEGIN(2, Foliage_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Foliage_Block)

// Textures, by material texture slot; Foliage.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    float t0 = Scene_Time.x * 1.05;
    float t1 = vec4(Inputs.WorldPosition, 1.0).x;
    float t2 = t1 * 0.004;
    float t3 = vec4(Inputs.WorldPosition, 1.0).z;
    float t4 = t3 * 0.005;
    float t5 = t2 + t4;
    float t6 = t0 + t5;
    float t7 = sin(t6);
    float t8 = t7 * 2.0;
    float t9 = Scene_Time.x * 1.73;
    float t10 = t5 * 1.6;
    float t11 = t9 + t10;
    float t12 = sin(t11);
    float t13 = t12 * 0.7;
    float t14 = t8 + t13;
    float t15 = t14 * 0.8;
    float t16 = Scene_Time.x * 6.8;
    float t17 = t1 * 0.09;
    float t18 = t3 * 0.07;
    float t19 = t17 + t18;
    float t20 = vec4(Inputs.WorldPosition, 1.0).y;
    float t21 = t20 * 0.05;
    float t22 = t19 + t21;
    float t23 = t16 + t22;
    float t24 = sin(t23);
    float t25 = t24 * 0.45;
    float t26 = t15 + t25;
    float t27 = t20 - 60.0;
    float t28 = t27 * 0.006666667;
    float t29 = clamp(t28, 0.0, 1.0);
    float t30 = mix(0.35, 1.0, t29);
    float t31 = t26 * t30;
    float t32 = Scene_Time.x * 8.3;
    float t33 = t22 * 1.3;
    float t34 = t32 + t33;
    float t35 = cos(t34);
    float t36 = t35 * 0.35;
