  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Glass". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Glass.material.
UBO_BLOCK_BEGIN(2, Glass_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Glass_Block)

// Textures, by material texture slot; Glass.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(1.6666666);
    vec4 t1 = texture(Material_Texture2, t0);
    float t2 = t1.g * 0.7;
    vec3 t3 = vec3(t2, t2, t2);
    vec3 t4 = mix(Param_Tint, vec3(0.52, 0.49, 0.44), t3);
    Surface.BaseColor = t4;
    float t5 = 1.0 - t2;
    Surface.Metallic = t5;
    Surface.Roughness = t1.r;
    vec3 t6 = Scene_CameraPosition.xyz - Inputs.WorldPosition;
    vec3 t7 = normalize(t6);
    float t8 = dot(t7, Inputs.WorldNormal);
    float t9 = abs(t8);
    float t10 = 1.0 - t9;
    float t11 = pow(t10, 5.0);
    float t12 = mix(0.13, 0.96, t11);
    float t13 = t2 * 0.3;
    float t14 = t12 + t13;
    float t15 = clamp(t14, 0.0, 1.0);
    Surface.Opacity = t15;
    vec4 t16 = texture(Material_Texture1, t0);
    vec3 t17 = Material_NormalMap(Inputs, t16.rgb, 0.7, t0, -1.0);
    Surface.Normal = t17;
}
#endif
]]></Output>
