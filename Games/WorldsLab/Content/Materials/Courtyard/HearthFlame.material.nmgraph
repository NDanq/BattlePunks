    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "HearthFlame". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in HearthFlame.material.
UBO_BLOCK_BEGIN(2, HearthFlame_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(HearthFlame_Block)

// Textures, by material texture slot; HearthFlame.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    float t0 = vec4(Inputs.TexCoord, 0.0, 1.0).x;
    float t1 = t0 - 0.5;
    float t2 = t1 * 2.0;
    float t3 = t0 * 0.35;
    float t4 = vec4(Inputs.WorldPosition, 1.0).x;
    float t5 = t4 * 0.021;
    float t6 = vec4(Inputs.WorldPosition, 1.0).z;
    float t7 = t6 * 0.017;
    float t8 = t5 + t7;
    float t9 = t3 + t8;
    float t10 = vec4(Inputs.TexCoord, 0.0, 1.0).y;
    float t11 = t10 * 0.45;
    float t12 = Scene_Time.x * 0.9;
    float t13 = t11 + t12;
    float t14 = t8 * 0.6;
    float t15 = t13 + t14;
    vec2 t16 = vec2(t9, t15);
    vec4 t17 = texture(Material_Texture1, t16);
    float t18 = t17.g - 0.5;
    float t19 = 1.0 - t10;
    float t20 = t19 * 1.1;
    float t21 = t18 * t20;
    float t22 = t2 + t21;
    float t23 = abs(t22);
    float t24 = 1.0 - t19;
    float t25 = pow(t24, 0.65);
    float t26 = t25 * 0.9;
    float t27 = t26 + 0.04;
    float t28 = t23 / t27;
    float t29 = 1.0 - t28;
    float t30 = clamp(t29, 0.0, 1.0);
    float t31 = smoothstep(0.0, 0.18, t19);
    float t32 = t30 * t31;
    float t33 = t32 * 2.2;
    float t34 = pow(t32, 3.0);
    float t35 = t34 * 5.0;
    float t36 = t33 + t35;
    vec3 t37 = vec3(t36, t36, t36);
    vec3 t38 = Inputs.Color.rgb * t37;
    Surface.Emissive = t38;
    float t39 = pow(t32, 0.8);
    float t40 = t39 * Inputs.Color.a;
    float t41 = clamp(t40, 0.0, 1.0);
    Surface.Opacity = t41;
}
#endif
]]></Output>
