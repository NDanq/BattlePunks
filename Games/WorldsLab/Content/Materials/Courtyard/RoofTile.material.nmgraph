  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "RoofTile". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in RoofTile.material.
UBO_BLOCK_BEGIN(2, RoofTile_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(RoofTile_Block)

// Textures, by material texture slot; RoofTile.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(1.0);
    vec4 t1 = texture(Material_Texture1, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec2 t3 = Inputs.TexCoord * vec2(0.22222222);
    vec4 t4 = texture(Material_Texture2, t3);
    float t5 = mix(0.8, 1.2, t4.r);
    vec3 t6 = vec3(t5, t5, t5);
    vec3 t7 = t2 * t6;
    Surface.BaseColor = t7;
    vec4 t8 = texture(Material_Texture3, t0);
    Surface.Metallic = t8.b;
    Surface.Roughness = t8.r;
    vec4 t9 = texture(Material_Texture4, t0);
    vec3 t10 = Material_NormalMap(Inputs, t9.rgb, 1.0, t0, -1.0);
    Surface.Normal = t10;
    Surface.AmbientOcclusion = t8.g;
}
#endif
]]></Output>
