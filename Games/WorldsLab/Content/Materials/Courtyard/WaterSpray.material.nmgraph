    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "WaterSpray". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in WaterSpray.material.
UBO_BLOCK_BEGIN(2, WaterSpray_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(WaterSpray_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = vec3(0.4, 0.44, 0.46);
    Surface.Roughness = 0.05;
    Surface.Specular = 1.0;
    vec3 t0 = Inputs.Color.rgb * vec3(0.03);
    Surface.Emissive = t0;
    float t1 = vec4(Inputs.TexCoord, 0.0, 1.0).x;
    float t2 = t1 - 0.5;
    float t3 = abs(t2);
    float t4 = t3 * 2.0;
    float t5 = 1.0 - t4;
    float t6 = clamp(t5, 0.0, 1.0);
    float t7 = pow(t6, 1.6);
    float t8 = t7 * Inputs.Color.a;
    float t9 = t8 * 0.55;
    Surface.Opacity = t9;
}
#endif
]]></Output>
