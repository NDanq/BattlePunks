  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Stucco". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Stucco.material.
UBO_BLOCK_BEGIN(2, Stucco_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Stucco_Block)

// Textures, by material texture slot; Stucco.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.5);
    vec4 t1 = texture(Material_Texture2, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    vec2 t3 = Inputs.TexCoord * vec2(0.11111111);
    vec4 t4 = texture(Material_Texture4, t3);
    float t5 = mix(0.89, 1.11, t4.r);
    vec3 t6 = vec3(t5, t5, t5);
    vec3 t7 = t2 * t6;
    float t8 = vec4(Inputs.WorldPosition, 1.0).y;
    float t9 = smoothstep(4.0, 95.0, t8);
    float t10 = mix(0.66, 1.0, t9);
    float t11 = mix(0.86, 1.03, t4.b);
    float t12 = t10 * t11;
    vec3 t13 = vec3(t12, t12, t12);
    vec3 t14 = t7 * t13;
    Surface.BaseColor = t14;
    vec4 t15 = texture(Material_Texture1, t0);
    Surface.Metallic = t15.b;
    Surface.Roughness = t15.r;
    vec4 t16 = texture(Material_Texture3, t0);
    vec3 t17 = Material_NormalMap(Inputs, t16.rgb, 0.45, t0, -1.0);
    Surface.Normal = t17;
    Surface.AmbientOcclusion = t15.g;
}
#endif
]]></Output>
