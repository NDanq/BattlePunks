    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Soot". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Soot.material.
UBO_BLOCK_BEGIN(2, Soot_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Soot_Block)

// Textures, by material texture slot; Soot.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec2 t0 = Inputs.TexCoord * vec2(0.6666667);
    vec4 t1 = texture(Material_Texture3, t0);
    vec3 t2 = t1.rgb * Param_Tint;
    Surface.BaseColor = t2;
    vec4 t3 = texture(Material_Texture1, t0);
    Surface.Metallic = t3.b;
    Surface.Roughness = 0.95;
    vec4 t4 = texture(Material_Texture2, t0);
    vec3 t5 = Material_NormalMap(Inputs, t4.rgb, 1.0, t0, -1.0);
    Surface.Normal = t5;
    Surface.AmbientOcclusion = t3.g;
}
#endif
]]></Output>
