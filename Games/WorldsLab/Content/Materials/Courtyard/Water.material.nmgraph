  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Water". Do not edit.
// Translucent, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Translucency Lighting Surface: specular over the opacity, premultiplied (MaterialTemplate_PS.glsl).
#define MATERIAL_TRANSLUCENCY_SURFACE 1

// Refraction: what is seen through it bent, read from this frame's opaque copy (Refraction.glsl).
#define MATERIAL_REFRACTION 1

// Bytes 0-159 are the engine's; the parameters' offsets are in Water.material.
UBO_BLOCK_BEGIN(2, Water_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
    vec3  Param_TransmissionTint;
UBO_BLOCK_END(Water_Block)

// Textures, by material texture slot; Water.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = Param_Tint;
    Surface.Roughness = 0.03;
    Surface.Specular = 0.25;
    Surface.Opacity = 0.15;
    vec2 t0 = Inputs.TexCoord * vec2(1.3);
    vec2 t1 = vec2(Scene_Time.x, Scene_Time.x);
    vec2 t2 = t1 * vec2(0.035, 0.021);
    vec2 t3 = t0 + t2;
    vec4 t4 = texture(Material_Texture1, t3);
    vec2 t5 = Inputs.TexCoord * vec2(0.55);
    vec2 t6 = t1 * vec2(-0.018, 0.03);
    vec2 t7 = t5 + t6;
    vec4 t8 = texture(Material_Texture1, t7);
    vec3 t9 = mix(t4.rgb, t8.rgb, vec3(0.5));
    vec3 t10 = Material_NormalMap(Inputs, t9, 0.45, t3, -1.0);
    Surface.Normal = t10;
    Surface.Refraction = 1.33;
    Surface.TransmissionTint = Param_TransmissionTint;
}
#endif
]]></Output>
