    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Embers". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Embers.material.
UBO_BLOCK_BEGIN(2, Embers_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Emissive;
UBO_BLOCK_END(Embers_Block)

// Textures, by material texture slot; Embers.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = vec3(0.05, 0.04, 0.035);
    Surface.Roughness = 0.9;
    vec2 t0 = Inputs.TexCoord * vec2(2.857143);
    vec4 t1 = texture(Material_Texture1, t0);
    float t2 = mix(0.25, 1.6, t1.g);
    vec3 t3 = vec3(t2, t2, t2);
    vec3 t4 = Param_Emissive * t3;
    Surface.Emissive = t4;
}
#endif
]]></Output>
