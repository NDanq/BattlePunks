  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Grass". Do not edit.
// Masked, Lit, Subsurface. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Grass.material.
UBO_BLOCK_BEGIN(2, Grass_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
    vec3  Param_Tint;
UBO_BLOCK_END(Grass_Block)

// Textures, by material texture slot; Grass.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    float t0 = Scene_Time.x * 0.9;
    float t1 = vec4(Inputs.WorldPosition, 1.0).x;
    float t2 = t1 * 7e-04;
    float t3 = vec4(Inputs.WorldPosition, 1.0).z;
    float t4 = t3 * 9e-04;
    float t5 = t2 + t4;
    float t6 = t0 + t5;
    float t7 = sin(t6);
    float t8 = t7 * 0.55;
    float t9 = Scene_Time.x * 2.1;
    float t10 = t5 * 1.7;
    float t11 = t9 + t10;
    float t12 = sin(t11);
    float t13 = t12 * 0.2;
    float t14 = t8 + t13;
    float t15 = t14 + 0.45;
    float t16 = t15 * Inputs.Color.a;
    float t17 = t16 * 6.0;
    float t18 = t17 * Scene_Wind.w;
    float t19 = vec4(Scene_Wind.xyz, 1.0).x;
    float t20 = t18 * t19;
    float t21 = Scene_Time.x * 3.3;
    float t22 = t1 * 0.021;
    float t23 = t3 * 0.017;
    float t24 = t22 + t23;
    float t25 = vec4(Inputs.WorldPosition, 1.0).y;
    float t26 = t25 * 0.013;
    float t27 = t24 + t26;
    float t28 = t21 + t27;
    float t29 = sin(t28);
    float t30 = t29 * 3.0;
    float t31 = t30 * Inputs.Color.a;
    float t32 = t31 * Scene_Wind.w;
    float t33 = t32 * 0.3;
    float t34 = t20 + t33;
    float t35 = vec4(Scene_Wind.xyz, 1.0).z;
    float t36 = t18 * t35;
    float t37 = t32 * 0.2;
    float t38 = t36 + t37;
    vec3 t39 = vec3(t34, t32, t38);
    return t39;
}
#endif

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Inputs.Color.rgb;
    vec3 t2 = t1 * Param_Tint;
    Surface.BaseColor = t2;
    Surface.Roughness = 0.9;
    Surface.Specular = 0.25;
    Surface.OpacityMask = t0.a;
    float t3 = vec4(Inputs.Color.rgb, 1.0).x;
    Surface.AmbientOcclusion = t3;
    vec3 t4 = t0.rgb * vec3(1.1, 1.25, 0.8);
    Surface.SubsurfaceColor = t4;
    Surface.Thickness = 0.45;
}
#endif
]]></Output>
