#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs)
{
    float t0 = Scene_Time.x * 0.9;
    float t1 = vec4(Inputs.WorldPosition, 1.0).x;
    float t2 = t1 * 7e-04;
    float t3 = vec4(Inputs.WorldPosition, 1.0).z;
    float t4 = t3 * 9e-04;
    float t5 = t2 + t4;
    float t6 = t0 + t5;
    float t7 = sin(t6);
    float t8 = t7 * 0.55;
    float t9 = Scene_Time.x * 2.1;
    float t10 = t5 * 1.7;
    float t11 = t9 + t10;
    float t12 = sin(t11);
    float t13 = t12 * 0.2;
    float t14 = t8 + t13;
    float t15 = t14 + 0.45;
    float t16 = t15 * Inputs.Color.a;
    float t17 = t16 * 30.0;
    float t18 = t17 * Scene_Wind.w;
    float t19 = vec4(Scene_Wind.xyz, 1.0).x;
    float t20 = t18 * t19;
    float t21 = Scene_Time.x * 3.3;
    float t22 = t1 * 0.021;
    float t23 = t3 * 0.017;
    float t24 = t22 + t23;
    float t25 = vec4(Inputs.WorldPosition, 1.0).y;
    float t26 = t25 * 0.013;
    float t27 = t24 + t26;
    float t28 = t21 + t27;
    float t29 = sin(t28);
    float t30 = t29 * 6.0;
    float t31 = vec4(Inputs.TexCoord, 0.0, 1.0).x;
    float t32 = t30 * t31;
    float t33 = t32 * Scene_Wind.w;
    float t34 = t33 * 0.3;
    float t35 = t20 + t34;
    float t36 = vec4(Scene_Wind.xyz, 1.0).z;
    float t37 = t18 * t36;
