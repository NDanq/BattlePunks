    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "SmokePerParticle". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Particle Lighting Per Particle: each instance lit at its centre (ParticleLighting.glsl).
#define MATERIAL_PARTICLE_LIGHTING 1
#define MATERIAL_PARTICLE_PHASE 0.3
#define MATERIAL_PARTICLE_SELF_OCCLUSION 0.5

// Bytes 0-159 are the engine's; the parameters' offsets are in SmokePerParticle.material.
UBO_BLOCK_BEGIN(2, SmokePerParticle_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(SmokePerParticle_Block)

#if VERTEX_SHADER
vec3 CalcMaterialOffset(in MaterialInputs Inputs) { return vec3(0.0); }
#endif

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.Emissive = Inputs.Color.rgb;
    float t0 = distance(Inputs.TexCoord, vec2(0.5));
    float t1 = t0 * 2.0;
    float t2 = 1.0 - t1;
    float t3 = clamp(t2, 0.0, 1.0);
    float t4 = t3 * t3;
    float t5 = t4 * Inputs.Color.a;
    Surface.Opacity = t5;
}
#endif
]]></Output>
