<?xml version="1.0" encoding="UTF-8"?>
<!--
  PvpBot: a Steampunk PvP bot's movement (WorldsLabPvP.cpp). It walks; the
  avatar input filter aims and pulls the trigger, through the same input a
  person's devices give, so a bot moves and fires by the prediction path and
  the RPC a player does. A utility selector, re-scored every 0.3 s:

    Engage       a target in sight and a loaded pistol: into range, then side
                 steps while the filter shoots
    Reload       an empty or nearly empty magazine: a step to one side while
                 the filter reloads
    Investigate  a shot heard or a target lost: go where it was
    Patrol       the street: a random point a block or two away

  Perception writes TargetActor, TargetVisible, TargetDistance, LastKnownPos,
  HeardNoise and NoisePos; the mode writes Ammo and Health.
-->
<BehaviorTree Format="1" Name="PvpBot">
  <Blackboard>
    <Key Name="TargetActor" Type="Entity" />
    <Key Name="TargetVisible" Type="Bool" Default="false" />
    <Key Name="TargetDistance" Type="Float" Default="5000" />
    <Key Name="LastKnownPos" Type="Vector" />
    <Key Name="HeardNoise" Type="Bool" Default="false" />
    <Key Name="NoisePos" Type="Vector" />
    <Key Name="Ammo" Type="Float" Default="1" />
    <Key Name="Health" Type="Float" Default="1" />
  </Blackboard>
  <UtilitySelector Interval="0.3" Hysteresis="0.2">
    <Sequence Name="Engage">
      <Consideration Input="TargetVisible" Curve="Step" XShift="0.5" />
      <Consideration Input="Ammo" Curve="Step" XShift="0.01" />
      <Consideration Input="TargetDistance" Max="4500" Curve="InverseLinear" />
      <Decorator Type="BlackboardCondition" Key="TargetActor" Op="IsSet" Abort="Self" />
      <Decorator Type="Loop" Count="0" />
      <Task Type="MoveTo" Key="TargetActor" AcceptanceRadius="1100" RepathDistance="300" />
      <Task Type="MoveToRandom" Radius="300" AcceptanceRadius="60" />
    </Sequence>
    <Sequence Name="Reload">
      <Consideration Input="Ammo" Curve="InverseLinear" />
      <Task Type="MoveToRandom" Radius="400" AcceptanceRadius="80" />
      <Wait Seconds="1.2" />
    </Sequence>
    <Sequence Name="Investigate" Weight="0.7">
      <Consideration Input="TargetVisible" Curve="InverseLinear" />
      <Consideration Input="HeardNoise" Curve="Step" XShift="0.5" />
      <Decorator Type="Cooldown" Seconds="3" />
      <Selector>
        <Task Type="MoveTo" Key="LastKnownPos" AcceptanceRadius="250">
          <Decorator Type="BlackboardCondition" Key="TargetActor" Op="IsSet" />
        </Task>
        <Task Type="MoveTo" Key="NoisePos" AcceptanceRadius="250" />
      </Selector>
    </Sequence>
    <Sequence Name="Patrol">
      <Consideration Curve="Constant" YShift="0.15" />
      <Task Type="MoveToRandom" Radius="3000" AcceptanceRadius="200" />
      <Wait Seconds="0.5" RandomDeviation="0.4" />
    </Sequence>
  </UtilitySelector>
</BehaviorTree>
