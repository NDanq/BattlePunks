  <Comments>
    <Comment X="-920" Y="-40" Width="1520" Height="360" Text="Each tick, on every process: this machine's own avatar (Game: Get Local Avatar), and whether its player just pressed Interact (E) -- the same harness query any avatar script makes." />
    <Comment X="-920" Y="400" Width="1260" Height="340" Text="Game.Unpossessed, heard on every process: someone got out of a kart (or let go of any avatar)." />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "Signpost". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    OnStart = function(self)
        self.GraphEventHandles = {
            Events.On("Unpossessed", function(...) self:Event_Unpossessed(...) end),
        }
    end,

    OnTick = function(self, dt)
        local t1 = Game.GetLocalAvatar(0)
        local t2 = t1:IsValid()
        if t2 then
            local t3 = Game.GetLocalAvatar(0)
            local t4 = t3:GetComponent("AvatarHarness")
            local t5 = t4:WasPressed("Interact")
            if t5 then
                local t6 = Game.GetLocalAvatar(0)
                local t7 = t6:GetName()
                local t8 = "NetArena (graph): Interact, from " .. t7
                print(t8)
            end
        end
    end,

    OnDestroy = function(self)
        for _, Handle in ipairs(self.GraphEventHandles or {}) do Events.Off(Handle) end
        self.GraphEventHandles = nil
    end,

    Event_Unpossessed = function(self, Arg1, Arg2, Arg3, Arg4)
        local t1 = Arg1:GetName()
        local t2 = "NetArena (graph): " .. t1
        local t3 = t2 .. " left "
        local t4 = Arg2:GetName()
        local t5 = t3 .. t4
        print(t5)
    end,
}
]]></Output>
  </gen_code>
