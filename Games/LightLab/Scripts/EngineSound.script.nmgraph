  <Comments>
    <Comment X="-1020" Y="-120" Width="1740" Height="500" Text="The buggy's engine: every frame after physics, the Audio Source's pitch follows the revs (IdlePitch at rest, RedlinePitch at MaxRPM) and its volume the throttle (CoastVolume off it, full on it)" />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "EngineSound". Do not edit.
return {
    TickPhase = TickPhase.PostPhysics,

    MaxRPM = 6000,
    IdlePitch = 0.6,
    RedlinePitch = 2,
    CoastVolume = 0.55,

    OnTick = function(self, dt)
        local t1 = self.Entity:GetComponent("Audio Source")
        local t2 = self.Entity:GetComponent("Vehicle")
        local t3 = t2:GetEngineRPM()
        local t4 = t3 / self.MaxRPM
        local t5 = math.max(0, math.min(1, t4))
        local t6 = self.IdlePitch + (self.RedlinePitch - self.IdlePitch) * t5
        t1:SetPitch(t6)
        local t7 = self.Entity:GetComponent("Audio Source")
        local t8 = self.Entity:GetComponent("Vehicle")
        local t9 = t8:GetForward()
        local t10 = math.abs(t9)
        local t11 = self.CoastVolume + (1 - self.CoastVolume) * t10
        t7:SetVolume(t11)
    end,
}
]]></Output>
  </gen_code>
