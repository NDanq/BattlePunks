<?xml version="1.0" encoding="utf-8"?>
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="UIOnly" Layer="10" OnBack="Native:LightLab.Resume">
  <Styles>
    <Style Name="MenuButton" Type="Button" Padding="32,14" Margin="0,8" Normal.Tint="#1C2430E6" Normal.OutlineColor="#FFFFFF2E" Normal.OutlineThickness="1" Hovered.Tint="#D98A2FF2" Hovered.OutlineColor="#FFE2BFE6" Hovered.OutlineThickness="2" Pressed.Tint="#99601AF2"/>
    <Style Name="MenuLabel" Type="Text" FontSize="34" Color="#F5F8FCFF" HAlign="Center" VAlign="Center"/>
  </Styles>
  <Canvas Name="Root">
    <Border Name="Dim" Anchors="0,0,1,1" Background.Tint="#05080DA6"/>
    <Border Name="Panel" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" AutoSize="true" Padding="56,44" Background.Tint="#0D121AE0" Background.OutlineColor="#FFFFFF26" Background.OutlineThickness="1">
      <VerticalBox Name="Content">
        <Text Name="Title" Text="Paused" FontSize="72" Color="#FFFFFFFF" HAlign="Center" Margin="0,0,0,32" ShadowOffset="0,3" ShadowColor="#00000099"/>
        <Button Name="Resume" Class="MenuButton" InitialFocus="true" OnClick="Native:LightLab.Resume">
          <Text Class="MenuLabel" Text="Resume"/>
        </Button>
        <Button Name="Quit" Class="MenuButton" OnClick="Native:Game.Quit">
          <Text Class="MenuLabel" Text="Quit"/>
        </Button>
        <Text Name="Hint" Text="Esc or (B) to resume" FontSize="20" Color="#FFFFFF73" HAlign="Center" Margin="0,32,0,0"/>
      </VerticalBox>
    </Border>
  </Canvas>
</UI>
