<?xml version="1.0" encoding="utf-8"?>
<UI Format="1" ReferenceSize="1920,1080" ScaleMode="FitHeight" InputMode="UIOnly" Layer="10" OnBack="Native:LightLab.Back">
  <Styles>
    <Style Name="MenuButton" Type="Button" Padding="32,14" Margin="0,8" Normal.Tint="#1C2430E6" Normal.OutlineColor="#FFFFFF2E" Normal.OutlineThickness="1" Hovered.Tint="#D98A2FF2" Hovered.OutlineColor="#FFE2BFE6" Hovered.OutlineThickness="2" Pressed.Tint="#99601AF2"/>
    <Style Name="MenuLabel" Type="Text" FontSize="34" Color="#F5F8FCFF" HAlign="Center" VAlign="Center"/>
    <Style Name="Heading" Type="Text" FontSize="72" Color="#FFFFFFFF" HAlign="Center" Margin="0,0,0,32" ShadowOffset="0,3" ShadowColor="#00000099"/>
    <Style Name="Setting" Type="CheckBox" Margin="0,10" BoxSize="34" Spacing="18" Box.Tint="#0A0E14E6" Box.OutlineColor="#FFFFFF4D" Box.OutlineThickness="2" BoxHovered.Tint="#1C2430F2" BoxHovered.OutlineColor="#D98A2FFF" BoxHovered.OutlineThickness="2" Check.Tint="#D98A2FFF"/>
    <Style Name="SettingLabel" Type="Text" FontSize="30" Color="#F5F8FCFF" VAlign="Center"/>
    <Style Name="SliderLabel" Type="Text" FontSize="30" Color="#F5F8FCFF" Margin="0,18,0,4"/>
    <Style Name="SliderValue" Type="Text" FontSize="28" Color="#FFFFFFB3" VAlign="Center" Margin="24,0,0,0"/>
    <Style Name="SettingSlider" Type="Slider" Size="460,40" ThumbSize="22,40" TrackHeight="8" Track.Tint="#0A0E14E6" Track.OutlineColor="#FFFFFF33" Track.OutlineThickness="1" FillBrush.Tint="#D98A2FF2" Thumb.Tint="#E6EBF2FF" ThumbHovered.Tint="#FFCC8CFF" ThumbHovered.OutlineColor="#FFFFFFFF" ThumbHovered.OutlineThickness="2"/>
  </Styles>
  <Canvas Name="Root">
    <Border Name="Dim" Anchors="0,0,1,1" Background.Tint="#05080DA6"/>
    <Border Name="Panel" Anchors="0.5,0.5,0.5,0.5" Pivot="0.5,0.5" AutoSize="true" Padding="56,44" Background.Tint="#0D121AE0" Background.OutlineColor="#FFFFFF26" Background.OutlineThickness="1">
      <VerticalBox Name="Content">
        <Switcher Name="Pages">
          <VerticalBox Name="Main" VAlign="Center">
            <Text Name="Title" Class="Heading" Text="Paused"/>
            <Button Name="Resume" Class="MenuButton" InitialFocus="true" OnClick="Native:LightLab.Resume">
              <Text Class="MenuLabel" Text="Resume"/>
            </Button>
            <Button Name="SettingsButton" Class="MenuButton" OnClick="Native:UI.ShowPage('Pages', 'Settings')">
              <Text Class="MenuLabel" Text="Settings"/>
            </Button>
            <Button Name="Quit" Class="MenuButton" OnClick="Native:Game.Quit">
              <Text Class="MenuLabel" Text="Quit"/>
            </Button>
          </VerticalBox>
          <VerticalBox Name="Settings">
            <Text Name="SettingsTitle" Class="Heading" Text="Settings"/>
            <CheckBox Name="Shadows" Class="Setting" Checked="{Bind:LightLab.Shadows}" OnChanged="Native:LightLab.SetShadows($value)">
              <Text Class="SettingLabel" Text="Shadows"/>
            </CheckBox>
            <CheckBox Name="BakedLighting" Class="Setting" Checked="{Bind:LightLab.BakedLighting}" OnChanged="Native:LightLab.SetBakedLighting($value)">
              <Text Class="SettingLabel" Text="Baked lighting"/>
            </CheckBox>
            <Text Class="SliderLabel" Text="Look sensitivity"/>
            <HorizontalBox>
              <Slider Name="LookSensitivity" Class="SettingSlider" Min="0.25" Max="3" Step="0.05" Value="{Bind:LightLab.LookSensitivity}" OnChanged="Native:LightLab.SetLookSensitivity($value)"/>
              <Text Class="SliderValue" Text="{Bind:LightLab.LookSensitivity}x"/>
            </HorizontalBox>
            <Text Class="SliderLabel" Text="Fly speed"/>
            <HorizontalBox>
              <Slider Name="FlySpeed" Class="SettingSlider" Min="100" Max="2000" Step="50" Value="{Bind:LightLab.FlySpeed}" OnChanged="Native:LightLab.SetFlySpeed($value)"/>
              <Text Class="SliderValue" Text="{Bind:LightLab.FlySpeed}"/>
            </HorizontalBox>
            <Button Name="LoadBakedLighting" Class="MenuButton" Margin="0,36,0,0" OnClick="Native:Game.OpenLevel('BakedLighting')">
              <Text Class="MenuLabel" Text="Load Baked Lighting World"/>
            </Button>
            <Button Name="Back" Class="MenuButton" OnClick="Native:UI.ShowPage('Pages', 'Main')">
              <Text Class="MenuLabel" Text="Back"/>
            </Button>
          </VerticalBox>
        </Switcher>
        <Text Name="Hint" Text="Esc or (B) to go back" FontSize="20" Color="#FFFFFF73" HAlign="Center" Margin="0,32,0,0"/>
      </VerticalBox>
    </Border>
  </Canvas>
</UI>
