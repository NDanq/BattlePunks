  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the UI graph "PauseMenu". Do not edit.
local Fn_Resume
Fn_Resume = function(self)
    UI.Close(self.Document)
    Game.SetPaused(false)
    Input.SetMouseCaptured(true)
end

return {

    OnOpen = function(self)
        local t1 = Config.GetBool("Shadows.Enabled")
        UI.SetBool("LightLab.Shadows", t1)
        local t2 = Config.GetBool("Rendering.BakedLighting")
        UI.SetBool("LightLab.BakedLighting", t2)
        local t3 = Config.GetNumber("LightLab.LookSensitivity")
        UI.SetNumber("LightLab.LookSensitivity", t3)
        local t4 = Config.GetNumber("LightLab.FlySpeed")
        UI.SetNumber("LightLab.FlySpeed", t4)
        UI.SetNumber("LightLab.Page", 0)
    end,

    Shadows_OnChanged = function(self, Value, Sender)
        Config.SetBool("Shadows.Enabled", (Value ~= 0))
    end,

    BakedLighting_OnChanged = function(self, Value, Sender)
        Config.SetBool("Rendering.BakedLighting", (Value ~= 0))
    end,

    LookSensitivity_OnChanged = function(self, Value, Sender)
        Config.SetNumber("LightLab.LookSensitivity", Value)
    end,

    FlySpeed_OnChanged = function(self, Value, Sender)
        Config.SetNumber("LightLab.FlySpeed", Value)
    end,

    Resume_OnClick = function(self, Value, Sender)
        Fn_Resume(self)
    end,

    Document_OnBack = function(self, Value, Sender)
        local t1 = UI.GetNumber("LightLab.Page")
        local t2 = t1 ~= 0
        if t2 then
            UI.SetNumber("LightLab.Page", 0)
        else
            Fn_Resume(self)
        end
    end,
}
]]></Output>
  </gen_code>
