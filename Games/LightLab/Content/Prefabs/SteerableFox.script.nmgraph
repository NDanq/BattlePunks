  <Comments>
    <Comment X="-1420" Y="-760" Width="1500" Height="340" Text="On Start: the yaw it was placed with, then its hat -- FoxHat spawned and parented to HatSocket (an Anim Socket on b_Head_05), so it rides the head" />
    <Comment X="-1420" Y="-60" Width="1420" Height="1400" Text="Every tick, in order: (1) sitting -- the anim state's Survey state -- holds it still (Drive 0); (3) J sits it, once nearly stopped" />
    <Comment X="180" Y="-60" Width="3960" Height="1300" Text="(2) Speed eases toward U's (Y runs: WalkSpeed to RunSpeed); H/K turn; it moves along its heading (+Z at yaw 0), and the anim state gets Speed (its walk/run blend space) and Look (I: the masked head layer)" />
  </Comments>
  <gen_code>
    <Output Extension=".lua"><![CDATA[-- Generated by NimbleEditor from the script graph "SteerableFox". Do not edit.
return {
    TickPhase = TickPhase.PrePhysics,

    WalkSpeed = 65,
    RunSpeed = 160,
    TurnRate = 120,
    HatPrefab = "Content/Prefabs/FoxHat.nmprefab",
    Yaw = 0,
    Speed = 0,
    Drive = 1,

    OnStart = function(self)
        local Root1
        local t1 = self.Entity:GetComponent("Transform")
        local t2_X, t2_Y, t2_Z = t1:GetRotation()
        self.Yaw = t2_Y
        Root1 = World.SpawnPrefab(self.HatPrefab, 0, 0, 0)
        local t3 = self.Instance:Find("HatSocket")
        Root1:SetParent(t3, false)
    end,

    OnTick = function(self, dt)
        local Set2, Set3, Set4
        local t1 = self.Instance:Find("Body")
        local t2 = t1:GetComponent("Animation")
        local t3 = t2:GetState(0)
        local t4 = t3 == "Survey"
        if t4 then
            self.Drive = 0
        else
            self.Drive = 1
        end
        local t5 = self.Entity:GetComponent("Input")
        local t6 = t5:GetAxis("FoxForward")
        local t7 = math.max(t6, 0)
        local t8 = t5:GetAxis("FoxRun")
        local t9 = self.WalkSpeed + (self.RunSpeed - self.WalkSpeed) * t8
        local t10 = t7 * t9
        local t11 = t10 * self.Drive
        local t12 = dt * 4
        local t13 = math.min(t12, 1)
        local t14 = self.Speed + (t11 - self.Speed) * t13
        self.Speed = t14
        local t15 = self.Entity:GetComponent("Input")
        local t16 = t15:GetAxis("FoxTurn")
        local t17 = t16 * self.TurnRate
        local t18 = t17 * dt
        local t19 = t18 * self.Drive
        local t20 = self.Yaw + t19
        self.Yaw = t20
        local t21 = self.Entity:GetComponent("Transform")
        t21:SetRotation(0, self.Yaw, 0)
        local t22 = self.Entity:GetComponent("Transform")
        local t23 = self.Yaw * 0.017453292519943295
        local t24 = math.sin(t23)
        local t25 = math.cos(t23)
        local t26 = self.Speed * dt
        local t27_X, t27_Y, t27_Z = t24 * t26, 0 * t26, t25 * t26
        t22:Translate(t27_X, t27_Y, t27_Z)
        local t28 = self.Instance:Find("Body")
        local t29 = t28:GetComponent("Animation")
        Set2 = t29:SetFloat("Speed", self.Speed)
        local t30 = self.Instance:Find("Body")
        local t31 = t30:GetComponent("Animation")
        local t32 = t31:GetFloat("Look")
        local t33 = self.Entity:GetComponent("Input")
        local t34 = t33:GetAxis("FoxLook")
        local t35 = dt * 3
        local t36 = math.min(t35, 1)
        local t37 = t32 + (t34 - t32) * t36
        Set3 = t31:SetFloat("Look", t37)
        local t38 = self.Entity:GetComponent("Input")
        local t39 = t38:WasPressed("FoxSit")
        local t40 = self.Speed < 10
        local t41 = t39 and t40
        if t41 then
            local t42 = self.Instance:Find("Body")
            local t43 = t42:GetComponent("Animation")
            Set4 = t43:SetTrigger("Sit")
        end
    end,
}
]]></Output>
  </gen_code>
