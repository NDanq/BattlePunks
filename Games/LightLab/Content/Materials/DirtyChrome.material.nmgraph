  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "DirtyChrome". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in DirtyChrome.material.
UBO_BLOCK_BEGIN(2, DirtyChrome_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(DirtyChrome_Block)

// Textures, by material texture slot; DirtyChrome.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)
MATERIAL_SAMPLER2D(9, Material_Texture5)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = Material_SampleCubeStrip(Material_Texture4, Material_ReflectionVector(Inputs, Inputs.WorldNormal));
    vec3 t1 = t0.rgb * vec3(0.1);
    vec4 t2 = texture(Material_Texture5, Inputs.TexCoord);
    vec3 t3 = t1 + t2.rgb;
    Surface.BaseColor = t3;
    vec4 t4 = texture(Material_Texture1, Inputs.TexCoord);
    Surface.Metallic = t4.r;
    vec4 t5 = texture(Material_Texture2, Inputs.TexCoord);
    Surface.Roughness = t5.r;
    vec4 t6 = texture(Material_Texture3, Inputs.TexCoord);
    Surface.Normal = t6.rgb;
}
#endif
]]></Output>
