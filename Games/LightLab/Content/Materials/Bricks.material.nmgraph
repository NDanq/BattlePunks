  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Bricks". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Bricks.material.
UBO_BLOCK_BEGIN(2, Bricks_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(Bricks_Block)

// Textures, by material texture slot; Bricks.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)
MATERIAL_SAMPLER2D(6, Material_Texture2)
MATERIAL_SAMPLER2D(7, Material_Texture3)
MATERIAL_SAMPLER2D(8, Material_Texture4)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture3, Inputs.TexCoord);
    Surface.BaseColor = t0.rgb;
    vec4 t1 = texture(Material_Texture1, Inputs.TexCoord);
    Surface.Metallic = t1.r;
    vec4 t2 = texture(Material_Texture2, Inputs.TexCoord);
    Surface.Roughness = t2.r;
    vec4 t3 = texture(Material_Texture4, Inputs.TexCoord);
    vec3 t4 = Material_NormalMap(Inputs, t3.rgb, 1.0, Inputs.TexCoord, -1.0);
    Surface.Normal = t4;
}
#endif
]]></Output>
