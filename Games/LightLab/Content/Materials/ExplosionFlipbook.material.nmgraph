  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ExplosionFlipbook". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ExplosionFlipbook.material.
UBO_BLOCK_BEGIN(2, ExplosionFlipbook_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(ExplosionFlipbook_Block)

// Textures, by material texture slot; ExplosionFlipbook.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec4 t0 = texture(Material_Texture1, Inputs.TexCoord);
    vec3 t1 = t0.rgb * Inputs.Color.rgb;
    vec3 t2 = t1 * vec3(2.0);
    Surface.Emissive = t2;
    float t3 = t0.a * Inputs.Color.a;
    Surface.Opacity = t3;
}
#endif
]]></Output>
