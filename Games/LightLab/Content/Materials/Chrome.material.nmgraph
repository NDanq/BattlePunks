    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Chrome". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-31 are the engine's; the parameters' offsets are in Chrome.material.
UBO_BLOCK_BEGIN(2, Chrome_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
UBO_BLOCK_END(Chrome_Block)

// Textures, by material texture slot; Chrome.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = vec3(0.02, 0.02, 0.025);
    Surface.Roughness = 0.15;
    vec4 t0 = Material_SampleCubeStrip(Material_Texture1, Material_ReflectionVector(Inputs, Inputs.WorldNormal));
    vec3 t1 = t0.rgb * vec3(0.95);
    Surface.Emissive = t1;
}
#endif
]]></Output>
