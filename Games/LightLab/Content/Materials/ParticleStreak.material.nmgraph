  <Comments>
    <Comment X="-780" Y="-140" Width="1500" Height="420" Text="Particle streak: soft across U only (one minus twice the distance from the middle, squared), solid along V -- for ribbons, beams and Velocity Aligned sparks. Opacity the particle's (Vertex Color), its colour three times as bright, so Bloom spreads it." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "ParticleStreak". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in ParticleStreak.material.
UBO_BLOCK_BEGIN(2, ParticleStreak_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(ParticleStreak_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    vec3 t0 = Inputs.Color.rgb * vec3(3.0);
    Surface.Emissive = t0;
    float t1 = Inputs.TexCoord.x - 0.5;
    float t2 = abs(t1);
    float t3 = t2 * 2.0;
    float t4 = 1.0 - t3;
    float t5 = clamp(t4, 0.0, 1.0);
    float t6 = t5 * t5;
    float t7 = t6 * Inputs.Color.a;
    Surface.Opacity = t7;
}
#endif
]]></Output>
