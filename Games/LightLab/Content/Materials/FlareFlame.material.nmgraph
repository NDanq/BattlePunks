  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "FlareFlame". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in FlareFlame.material.
UBO_BLOCK_BEGIN(2, FlareFlame_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(FlareFlame_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = vec3(1.0, 0.3, 0.1);
    float t0 = Scene_Time.x * 23.0;
    float t1 = sin(t0);
    float t2 = Scene_Time.x * 7.0;
    float t3 = sin(t2);
    float t4 = t1 + t3;
    float t5 = t4 + 12.0;
    vec3 t6 = vec3(1.0, 0.18, 0.04) * vec3(t5);
    Surface.Emissive = t6;
}
#endif
]]></Output>
