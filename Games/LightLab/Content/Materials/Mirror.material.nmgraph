  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "Mirror". Do not edit.
// Opaque, Lit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in Mirror.material.
UBO_BLOCK_BEGIN(2, Mirror_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(Mirror_Block)

// Textures, by material texture slot; Mirror.material names each one's file and sampler.
MATERIAL_SAMPLER2D(5, Material_Texture1)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.BaseColor = vec3(0.02, 0.02, 0.025);
    Surface.Roughness = 0.15;
    vec4 t0 = texture(Material_Texture1, Material_MirrorUV(Inputs));
    vec3 t1 = t0.rgb * vec3(0.85, 0.9, 1.0);
    Surface.Emissive = t1;
}
#endif
]]></Output>
