# Editor world files (GameCore's WorldPackage.h) are written with LF line
# endings and skipped on save when their bytes are unchanged; converting them
# to CRLF on checkout would make every save rewrite every file.
*.nmworld  text eol=lf
*.nmentity text eol=lf
# Prefabs and the instance files a world places them with, the same way.
*.nmprefab     text eol=lf
*.nmprefabinst text eol=lf

# NodeGraph's golden files are compared byte for byte with generated code,
# which is LF; CRLF on checkout would fail every one.
Engine/Modules/NodeGraph/Tests/Data/** text eol=lf

# The example fixture is compared byte for byte with what its LF archives
# unpack to, and repacked into them; CRLF on checkout would fail both.
Engine/Modules/Editor/Tests/Data/ExampleProject/** text=auto eol=lf
