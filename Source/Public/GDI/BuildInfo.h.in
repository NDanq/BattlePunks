#pragma once
// ==========================================================================
// Generated from this template by cmake/GitVersion.cmake, at configure time
// and again on every build. DO NOT EDIT the generated header, and DO NOT
// commit it -- it lands in the build tree (Generated/BuildInfo.h).
//
// Only produced when GDI is built as its own top-level project. Inside
