// ==========================================================================

#define GDI_VERSION           "@GDI_VERSION@"

// `git describe`: "v0.2.0-14-gabc123def456[-dirty]" once release tags exist,
// a bare short SHA (optionally "-dirty") until then.
#define GDI_GIT_DESCRIBE      "@GDI_GIT_DESCRIBE@"
#define GDI_GIT_SHA           "@GDI_GIT_SHA@"
#define GDI_GIT_SHA_SHORT     "@GDI_GIT_SHA_SHORT@"
#define GDI_GIT_BRANCH        "@GDI_GIT_BRANCH@"
#define GDI_GIT_COMMIT_DATE   "@GDI_GIT_COMMIT_DATE@"   // ISO 8601 UTC
#define GDI_GIT_DIRTY         @GDI_GIT_DIRTY@           // 0 or 1

// Monotonic build counter from CI ($BUILD_NUMBER, else $GITHUB_RUN_NUMBER);
// 0 for local developer builds.
#define GDI_BUILD_NUMBER      @GDI_BUILD_NUMBER@

// One-line summary for logs / diagnostics.
#define GDI_VERSION_STRING    "@GDI_VERSION_STRING@"
