# ===========================================================================
# NimbleEngine repository root .gitignore
#
# Each vendored module subtree (Engine/Modules/Core, Engine/Modules/GDI) keeps
# its own .gitignore for the standalone case. This file covers only what the
# engine-level aggregate produces, which no subtree can know about.
# ===========================================================================

# The flat runtime layout Engine/CMakeLists.txt sets up, and the per-generation
# shadow copies CoreModuleManager writes underneath it during hot reload.
#
# It belongs to the HOST being built rather than to the engine, since there is
# exactly one such directory per build and the exe has to be in it --
# NIMBLE_BINARIES_DIR defaults to the Sandbox host's. Engine/Binaries stays
# listed so that older build trees, and anyone pointing NIMBLE_BINARIES_DIR back
# at it, do not start showing up as untracked output -- all but the tracked
# NewProject scripts, which make a game without the editor.
/Games/*/Binaries/

# What the tools make on each machine, never source: cooked content
# (Saved/Cooked/, from the editor's Build > Cook Content) and a log per editor,
# game, cook and build run (Saved/Logs/).
/Games/*/Saved/
# And the engine's: its shaders, cooked by NimbleCook (Saved/Cooked/Shaders/).
/Engine/Saved/
# And each plugin's (Engine/cmake/NimblePlugins.cmake): its shaders, cooked
# by NimbleCook into <plugin>/Saved/Cooked/Shaders/.
/Engine/Plugins/*/Saved/
/Games/*/Plugins/*/Saved/

# The vendored libraries, built once per toolchain and shared by every build
# tree (Engine/cmake/NimbleThirdParty.cmake).
/Engine/Intermediate/

/Engine/Binaries/*
!/Engine/Binaries/NewProject.cmake
!/Engine/Binaries/NewProject.sh
!/Engine/Binaries/NewProject.bat

# Smoke-test scratch output. The test writes it relative to its working
# directory, and the executable can be run from anywhere -- including here.
/SmokeScratch/
/Engine/SmokeScratch/
/Games/*/Binaries/SmokeScratch/

# Shader debug information (Editor Settings > Shaders > ShaderPDB), written by
# the editor's shader cooks per target.
/Engine/Shaders/PDBs/

# Engine-level build trees.
#
# The repo-root entries are for a tree configured from here with -B build --
# `cmake -S Engine -B build` is the usual invocation and writes the tree
# beside Engine/ rather than inside it, so the /Engine/ entries below do not
# catch it.
/Build/
/build/
/cmake-build-*/
# A second tree per NIMBLE_TARGET, e.g. `cmake -S Engine -B build-client
# -DNIMBLE_TARGET=Client`.
/build-*/
/Engine/Build/
/Engine/build/
/Engine/cmake-build-*/

# Standalone build trees for the hosts under Games/.
/Games/*/Build/
/Games/*/build/
/Games/*/cmake-build-*/

# Editor / IDE / local tooling state
.idea/
.vs/
.vscode/
*.user
.cache/
.claude/settings.local.json

# Locally generated MSVC environment. vcvars64.bat cannot always be driven
# through cmd.exe (some shells get its banner and no variables), so these lift
# the toolchain environment out once into a sourceable file. Machine-specific
# by construction -- they bake in this box's Visual Studio install path and SDK
# version -- so they are regenerated rather than shared.
/get_msvc_env.ps1
/make_msvc_env.py
/msvc_env.sh

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store
