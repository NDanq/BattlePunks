# ===========================================================================
# Core (EngineCore) .gitignore
#
# Written for when Core is split out into its own repo -- all paths are
# relative to this directory. Harmless while Core still lives inside the
# Odessa monorepo (the root .gitignore covers the same ground).
# ===========================================================================

# ---------------------------------------------------------------------------
# CMake / Ninja build trees
# ---------------------------------------------------------------------------
/Build/
/BuildNoAlias/
/Binaries/
build/
cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeUserPresets.json
compile_commands.json
Testing/

# ---------------------------------------------------------------------------
# Compiled objects, libraries and executables
# ---------------------------------------------------------------------------
*.obj
*.o
*.lib
*.a
*.exe
*.dll
*.so
*.so.*
*.dylib
*.pdb
*.ilk
*.exp
*.idb
*.pch
*.gch

# ---------------------------------------------------------------------------
# Runtime scratch and logs
#
# /SmokeScratch is scratch output from the smoke test. The checked-in test
# fixtures under Source/Public/Math/SmokeScratch are anchored away from this
# rule and stay tracked.
# ---------------------------------------------------------------------------
/SmokeScratch/
/Logs/
*.log

# ---------------------------------------------------------------------------
# Qt tooling codegen
# ---------------------------------------------------------------------------
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
.qmake.stash

# ---------------------------------------------------------------------------
# Editor / IDE / local tooling state
# ---------------------------------------------------------------------------
.idea/
.vs/
.vscode/
*.user
.cache/
.claude/settings.local.json

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
