#version 440 core
// Generated by NimbleEditor from the material graph "Logic". Do not edit.

#include <MaterialPlatform.glsl>
#include <Common.glsl>

OUTPUT(0, vec4, Output)

// Columns 0-2: parameters (see Logic.material); column 3: the primitive's tint.
UBO_BEGIN(2, Logic_Block)
    SHADER_UNIFORM(mat4, MaterialParams)
UBO_END(Logic_Block)

void main(void)
{
    vec2 t0 = sin(Interpolants.TexCoord);
    vec2 t1;
    HINT_BRANCH if(Interpolants.TexCoord.x > 0.5)
    {
        vec2 t2 = t0 * vec2(2.0);
        t1 = t2;
    }
    else
    {
        t1 = t0;
    }
    vec2 t3 = t1;
    HINT_UNROLL for(int i0 = 0; i0 < 4; ++i0)
    {
        vec2 t4 = vec2(float(i0)) * t0;
        vec2 t5 = t3 + t4;
        t3 = t5;
    }
    Output = vec4(t3, 0.0, 1.0);
}
