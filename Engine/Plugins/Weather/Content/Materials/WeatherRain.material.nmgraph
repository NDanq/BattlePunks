  <Comments>
    <Comment X="-780" Y="-160" Width="1620" Height="460" Text="Weather's rain streak: Velocity Aligned sprites. Soft across U (one minus twice the distance from the middle, squared) and tapered along V, so each drop is a thin streak fading at both ends. Colour and opacity the particle's (Vertex Color): the rain's colour times the component's Tint, which the plugin sets from the Sky Light." />
  </Comments>
  <gen_code>
    <Output Extension=".mtl.glsl"><![CDATA[// Generated by NimbleEditor from the material graph "WeatherRain". Do not edit.
// Translucent, Unlit. Included by Engine/Content/Shaders/MaterialTemplate_VS/PS.glsl.

// Bytes 0-159 are the engine's; the parameters' offsets are in WeatherRain.material.
UBO_BLOCK_BEGIN(2, WeatherRain_Block)
    vec4  Material_Tint;
    float Material_ClipValue;
    float Material_TwoSided;
    float Material_Reserved0;
    float Material_Reserved1;
    vec4  Material_LightmapScaleOffset;
    vec4  Material_BakedLighting;
    vec4  Material_AmbientCube[6];
UBO_BLOCK_END(WeatherRain_Block)

#if PIXEL_SHADER
void CalcMaterial(in MaterialInputs Inputs, inout MaterialSurface Surface)
{
    Surface.Emissive = Inputs.Color.rgb;
    float t0 = Inputs.TexCoord.x - 0.5;
    float t1 = abs(t0);
    float t2 = t1 * 2.0;
    float t3 = 1.0 - t2;
    float t4 = clamp(t3, 0.0, 1.0);
    float t5 = t4 * t4;
    float t6 = Inputs.TexCoord.y - 0.5;
    float t7 = abs(t6);
    float t8 = t7 * 2.0;
    float t9 = 1.0 - t8;
    float t10 = clamp(t9, 0.0, 1.0);
    float t11 = t5 * t10;
    float t12 = t11 * Inputs.Color.a;
    Surface.Opacity = t12;
}
#endif
]]></Output>
